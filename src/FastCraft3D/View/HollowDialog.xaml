<Window x:Class="FastCraft3D.View.HollowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hollow" SizeToContent="Height" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Wall" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="52" />
            <TextBox x:Name="WallBox" Width="64" Padding="4,3" HorizontalContentAlignment="Right"
                     TextChanged="OnWallTyped" />
            <TextBlock Text="mm" VerticalAlignment="Center" Foreground="#FF9AA0A8" Margin="6,0,0,0" />
        </StackPanel>
        <Slider x:Name="WallSlider" Minimum="0.4" Maximum="15" TickFrequency="0.2"
                IsSnapToTickEnabled="True" ValueChanged="OnWallDragged" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Detail" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="52" />
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="#FF33383F" />
        </StackPanel>
        <Slider x:Name="DetailSlider" Minimum="40" Maximum="240" TickFrequency="10"
                IsSnapToTickEnabled="True" ValueChanged="OnWallDragged" Margin="0,0,0,12" />

        <Border Padding="10,8" CornerRadius="3"
                Background="#FFFFF6E8" BorderBrush="#FFE8C88A" BorderThickness="1">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FF6B4E12" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Leave open" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="82"
                       ToolTip="A shell open on one side - the underside of a roof, the back of a facade. None seals it all round." />
            <ComboBox x:Name="OpenBox" Width="110" SelectedIndex="0"
                      AutomationProperties.AutomationId="HollowOpenSide">
                <ComboBoxItem Content="Nothing" />
                <ComboBoxItem Content="The bottom" />
                <ComboBoxItem Content="The top" />
                <ComboBoxItem Content="The front" />
                <ComboBoxItem Content="The back" />
                <ComboBoxItem Content="The left" />
                <ComboBoxItem Content="The right" />
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hollow" IsDefault="True" Click="OnAccept"
                    MinWidth="88" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </StackPanel>
</Window>
