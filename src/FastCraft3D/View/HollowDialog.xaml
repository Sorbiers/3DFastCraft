<view:ToolPanel x:Class="FastCraft3D.View.HollowDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Hollow">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Wall" Style="{DynamicResource FieldLabel}" Width="62" />
            <TextBox x:Name="WallBox" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnWallTyped" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <Slider x:Name="WallSlider" Minimum="0.4" Maximum="15" TickFrequency="0.2"
                IsSnapToTickEnabled="True" ValueChanged="OnWallDragged" Margin="0,4,0,8" />

        <DockPanel>
            <TextBlock Text="Detail" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Voxels along the model's longest side. The wall is measured on this grid." />
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="#FF33383F" TextWrapping="Wrap" />
        </DockPanel>
        <Slider x:Name="DetailSlider" Minimum="40" Maximum="240" TickFrequency="10"
                IsSnapToTickEnabled="True" ValueChanged="OnWallDragged" Margin="0,4,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Leave open" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="A shell open on one side - the underside of a roof, the back of a facade. Nothing seals it all round." />
            <ComboBox x:Name="OpenBox" Width="120" SelectedIndex="0"
                      AutomationProperties.AutomationId="HollowOpenSide">
                <ComboBoxItem Content="Nothing" />
                <ComboBoxItem Content="The bottom" />
                <ComboBoxItem Content="The top" />
                <ComboBoxItem Content="The front" />
                <ComboBoxItem Content="The back" />
                <ComboBoxItem Content="The left" />
                <ComboBoxItem Content="The right" />
            </ComboBox>
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="#FFFFF6E8" BorderBrush="#FFE8C88A" BorderThickness="1">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FF6B4E12" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Hollow" Style="{DynamicResource PanelButton}" Click="OnAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</view:ToolPanel>
