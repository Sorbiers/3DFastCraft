<Window x:Class="FastCraft3D.View.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:FastCraft3D.View"
        Title="Settings" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF33383F" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7A8088" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,8" />
        </Style>
        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="view:NumberField.IsOn" Value="True" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,14">
        <TextBlock Text="Printer profile" FontWeight="SemiBold" Foreground="#FF33383F" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="The Library's walls and fits start from these, and so do Hole, the connectors of Split and Connect, brick studs, Mold's keys and Keyhole. One profile for each printer and filament: PLA and PETG want different fits." />

        <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="Delete" Click="OnDelete" x:Name="DeleteButton"
                    Padding="10,3" Margin="6,0,0,0" ToolTip="Forget this profile" />
            <Button DockPanel.Dock="Right" Content="New" Click="OnNew"
                    Padding="10,3" Margin="6,0,0,0" ToolTip="A new profile, starting as a copy of this one" />
            <ComboBox x:Name="ProfileList" SelectionChanged="OnProfileChosen" AutomationProperties.AutomationId="Profiles" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource Label}" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Padding="4,2" Margin="0,0,0,8"
                     AutomationProperties.AutomationId="ProfileName" />

            <TextBlock Grid.Row="1" Text="Nozzle" Style="{StaticResource Label}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NozzleBox" Style="{StaticResource Box}" AutomationProperties.AutomationId="Nozzle" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource Label}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Near enough the width of one printed line. Walls are made a whole number of these." />

            <TextBlock Grid.Row="3" Text="Layer height" Style="{StaticResource Label}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LayerBox" Style="{StaticResource Box}" AutomationProperties.AutomationId="Layer" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Style="{StaticResource Label}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Thin features and print-in-place gaps are rounded to it." />

            <TextBlock Grid.Row="5" Text="Sliding clearance" Style="{StaticResource Label}" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="SlidingBox" Style="{StaticResource Box}" AutomationProperties.AutomationId="Sliding" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="mm per side" Style="{StaticResource Label}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="For parts that slide or turn: lids, hinges, drawers, shafts, Mold's keys, Keyhole." />

            <TextBlock Grid.Row="7" Text="Hole clearance" Style="{StaticResource Label}" />
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="HoleBox" Style="{StaticResource Box}" AutomationProperties.AutomationId="Hole" />
            <TextBlock Grid.Row="7" Grid.Column="2" Text="mm per side" Style="{StaticResource Label}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Added to a round hole so a pin or screw of its size goes in: Hole, and the pins and pegs of Split and Connect." />

            <TextBlock Grid.Row="9" Text="Brick fit" Style="{StaticResource Label}" />
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="BrickBox" Style="{StaticResource Box}" AutomationProperties.AutomationId="Brick" />
            <TextBlock Grid.Row="9" Grid.Column="2" Text="mm" Style="{StaticResource Label}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="How much larger brick studs and what grips them are made. Negative is looser: -0.1 suits most PLA." />

            <TextBlock Grid.Row="11" Text="Thread clearance" Style="{StaticResource Label}" />
            <TextBox Grid.Row="11" Grid.Column="1" x:Name="ThreadBox" Style="{StaticResource Box}" AutomationProperties.AutomationId="Thread" />
            <TextBlock Grid.Row="11" Grid.Column="2" Text="mm on the diameter" Style="{StaticResource Label}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Between a printed thread and its nut: Thread, bolts and nuts in the Library." />
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="#FFB3261E" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="Print a test of these..." Click="OnPrintTest"
                    Padding="10,6" AutomationProperties.AutomationId="PrintProfileTest"
                    ToolTip="Keep these and open the Library's Printer profile test: every fit on one plate, a few samples either side of these numbers" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Click="OnAccept" MinWidth="80" Padding="10,6" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
