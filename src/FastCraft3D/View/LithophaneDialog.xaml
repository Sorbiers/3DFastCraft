<view:ToolPanel x:Class="FastCraft3D.View.LithophaneDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Lithophane">

    <view:ToolPanel.Resources>
        <!-- Label, the number itself, its unit, and a slider for the same value. -->
        <Style x:Key="LithoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style x:Key="LithoSlider" TargetType="Slider">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>
        <Style x:Key="LithoUnit" TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Foreground" Value="#FF9AA0A8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </view:ToolPanel.Resources>

    <StackPanel>
        <TextBlock Text="A picture carried as thickness in a thin plate: thin where it is white, thick where it is dark. It shows nothing until it is lit from behind."
                   TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="ChooseButton" Content="Picture" Style="{DynamicResource PanelButton}" Click="OnChoose"
                    AutomationProperties.AutomationId="LithophanePicture"
                    ToolTip="PNG, JPEG, BMP, GIF or TIFF. Anything see-through is read as white." />
            <TextBlock x:Name="PictureText" VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="150"
                       TextTrimming="CharacterEllipsis" Foreground="#FF5A5F66" />
        </StackPanel>

        <!-- What it will look like lit, stepped to the layers it will really print at. -->
        <Border Margin="0,0,0,8" Padding="4" Background="#FF23262A" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <Image x:Name="Backlit" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Width" Style="{DynamicResource FieldLabel}"
                       ToolTip="Across the picture itself; the height follows its proportions" />
            <TextBox Grid.Column="1" x:Name="WidthBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneWidth" />
            <TextBlock Text="mm" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="WidthSlider" Style="{StaticResource LithoSlider}" Minimum="20" Maximum="300"
                    TickFrequency="1" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Thinnest" Style="{DynamicResource FieldLabel}"
                       ToolTip="Where the picture is white. Thin enough to pass the light, thick enough to print: 0.8 mm suits most printers." />
            <TextBox Grid.Column="1" x:Name="MinBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneMin" />
            <TextBlock Text="mm" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="MinSlider" Style="{StaticResource LithoSlider}" Minimum="0.2" Maximum="3"
                    TickFrequency="0.05" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Thickest" Style="{DynamicResource FieldLabel}"
                       ToolTip="Where it is black. Further apart than the thin end gives more contrast, and takes longer to print." />
            <TextBox Grid.Column="1" x:Name="MaxBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneMax" />
            <TextBlock Text="mm" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="MaxSlider" Style="{StaticResource LithoSlider}" Minimum="0.6" Maximum="8"
                    TickFrequency="0.05" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Detail" Style="{DynamicResource FieldLabel}"
                       ToolTip="Millimetres between samples. About the nozzle's own width is as fine as there is any point going: finer only adds triangles." />
            <TextBox Grid.Column="1" x:Name="PitchBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophanePitch" />
            <TextBlock Text="mm" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="PitchSlider" Style="{StaticResource LithoSlider}" Minimum="0.1" Maximum="1"
                    TickFrequency="0.05" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Layers" Style="{DynamicResource FieldLabel}"
                       ToolTip="The layer height it will be printed at. It decides how many greys survive, and is only used to say so." />
            <TextBox Grid.Column="1" x:Name="LayerBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneLayer" />
            <TextBlock Text="mm" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="LayerSlider" Style="{StaticResource LithoSlider}" Minimum="0.04" Maximum="0.4"
                    TickFrequency="0.01" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Frame" Style="{DynamicResource FieldLabel}"
                       ToolTip="A border at the full thickness round the picture, which stops the light and stiffens the plate. Zero for none." />
            <TextBox Grid.Column="1" x:Name="FrameBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneFrame" />
            <TextBlock Text="mm" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="FrameSlider" Style="{StaticResource LithoSlider}" Minimum="0" Maximum="12"
                    TickFrequency="0.5" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Brightness" Style="{DynamicResource FieldLabel}"
                       ToolTip="Lighter or darker all over, from -1 to 1. Zero leaves it alone." />
            <TextBox Grid.Column="1" x:Name="BrightnessBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneBrightness" />
            <Slider x:Name="BrightnessSlider" Style="{StaticResource LithoSlider}" Minimum="-1" Maximum="1"
                    TickFrequency="0.02" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contrast" Style="{DynamicResource FieldLabel}"
                       ToolTip="Spread about mid grey. One leaves it alone; over one pushes the lights and darks apart, under one draws them together." />
            <TextBox Grid.Column="1" x:Name="ContrastBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneContrast" />
            <Slider x:Name="ContrastSlider" Style="{StaticResource LithoSlider}" Minimum="0.2" Maximum="3"
                    TickFrequency="0.02" ValueChanged="OnSlide" />
        </Grid>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Gamma" Style="{DynamicResource FieldLabel}"
                       ToolTip="Over one darkens the middle tones, under one lifts them. The one control worth reaching for when a picture comes out flat." />
            <TextBox Grid.Column="1" x:Name="GammaBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneGamma" />
            <Slider x:Name="GammaSlider" Style="{StaticResource LithoSlider}" Minimum="0.2" Maximum="3"
                    TickFrequency="0.02" ValueChanged="OnSlide" />
        </Grid>

        <CheckBox x:Name="NegativeBox" Content="Negative" Margin="68,4,0,0" Click="OnChanged"
                  AutomationProperties.AutomationId="LithophaneNegative"
                  ToolTip="Light for dark, for a picture meant to be read the other way round" />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Shape" Style="{DynamicResource FieldLabel}" Width="68" />
            <RadioButton x:Name="FlatBox" GroupName="LithophaneShape" Content="Flat" Margin="0,0,10,0" VerticalAlignment="Center"
                         Checked="OnChanged" AutomationProperties.AutomationId="LithophaneFlat" />
            <RadioButton x:Name="CurvedBox" GroupName="LithophaneShape" Content="Curved" VerticalAlignment="Center"
                         Checked="OnChanged" AutomationProperties.AutomationId="LithophaneCurved"
                         ToolTip="Bent round a cylinder, the picture on the outside - for a shade with the lamp inside it" />
        </StackPanel>

        <Grid Style="{StaticResource LithoRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Round" Style="{DynamicResource FieldLabel}"
                       ToolTip="How far round the cylinder it goes" />
            <TextBox Grid.Column="1" x:Name="AngleBox" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="LithophaneAngle" />
            <TextBlock Text="&#176;" Style="{StaticResource LithoUnit}" />
            <Slider x:Name="AngleSlider" Style="{StaticResource LithoSlider}" Minimum="10" Maximum="350"
                    TickFrequency="5" ValueChanged="OnSlide" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="Add" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="LithophaneAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
