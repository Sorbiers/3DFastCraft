<view:ToolPanel x:Class="FastCraft3D.View.SimplifyDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Simplify">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Keep" Style="{DynamicResource FieldLabel}" Width="62" />
            <TextBlock x:Name="AmountText" VerticalAlignment="Center" Foreground="#FF33383F" />
        </StackPanel>
        <Slider x:Name="AmountSlider" Minimum="1" Maximum="100" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnAmountChanged" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Simplify" Style="{DynamicResource PanelButton}" Click="OnAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
