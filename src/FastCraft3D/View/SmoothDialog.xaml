<view:ToolPanel x:Class="FastCraft3D.View.SmoothDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Smooth">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Smoothness" Style="{DynamicResource FieldLabel}" Width="80"
                       ToolTip="How hard the surface is pulled toward its own average" />
            <TextBlock x:Name="AmountText" VerticalAlignment="Center" Foreground="#FF33383F" />
        </StackPanel>
        <Slider x:Name="AmountSlider" Minimum="0" Maximum="20" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnAmountChanged" Margin="0,4,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Detail" Style="{DynamicResource FieldLabel}" Width="80"
                       ToolTip="How finely the shape is divided up before smoothing. Smoothing can only move the points it has." />
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="#FF33383F" />
        </StackPanel>
        <Slider x:Name="DetailSlider" Minimum="0" Maximum="3" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnAmountChanged" Margin="0,4,0,8" />

        <CheckBox x:Name="MoveRim" Content="Smooth open edges"
                  Checked="OnAmountChanged" Unchecked="OnAmountChanged"
                  ToolTip="Let the rim of an unclosed shape move too. Off keeps openings their proper shape; it makes no difference to a closed model." />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Smooth" Style="{DynamicResource PanelButton}" Click="OnAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" Click="OnCancel" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
