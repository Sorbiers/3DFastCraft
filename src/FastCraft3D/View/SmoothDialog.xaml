<Window x:Class="FastCraft3D.View.SmoothDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smooth" SizeToContent="Height" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Smoothness" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="86" />
            <TextBlock x:Name="AmountText" VerticalAlignment="Center" Foreground="#FF33383F" />
        </StackPanel>
        <Slider x:Name="AmountSlider" Minimum="0" Maximum="20" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnAmountChanged" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Detail" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="86"
                       ToolTip="How finely the shape is divided up before smoothing. Smoothing can only move the points it has." />
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="#FF33383F" />
        </StackPanel>
        <Slider x:Name="DetailSlider" Minimum="0" Maximum="3" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnAmountChanged" Margin="0,0,0,12" />

        <CheckBox x:Name="MoveRim" Content="Smooth open edges" Margin="0,0,0,10"
                  Checked="OnAmountChanged" Unchecked="OnAmountChanged"
                  ToolTip="Let the rim of an unclosed shape move too. Off keeps openings their proper shape; it makes no difference to a closed model." />

        <Border Padding="10,8" CornerRadius="3"
                Background="#FFEFF1F4" BorderBrush="#FFDDE0E4" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Smooth" IsDefault="True" Click="OnAccept"
                    MinWidth="88" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
