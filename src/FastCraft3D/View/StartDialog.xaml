<Window x:Class="FastCraft3D.View.StartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3DFastCraft" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#FFF7F7F8">

    <Window.Resources>
        <!-- A project to open: its picture, read lazily, and its name, with the folder under it. -->
        <DataTemplate x:Key="ProjectTile">
            <Button Click="OnProject" Tag="{Binding Path}" ToolTip="{Binding Path}" Margin="0,0,0,6" Padding="6"
                    HorizontalContentAlignment="Stretch" Background="#FFFFFFFF" BorderBrush="#FFD8DBE0"
                    AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="64" Height="64" Margin="0,0,12,0" CornerRadius="3"
                            Background="#FFEEF0F3" BorderBrush="#FFD8DBE0" BorderThickness="1">
                        <Image Source="{Binding Picture}" Stretch="Uniform" Margin="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF23303C" />
                        <TextBlock Text="{Binding Folder}" Foreground="#FF7A8088" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- The pushpin of the ribbon's Pin button, drawn here because a dialog does not see the
             ribbon's icons. -->
        <StreamGeometry x:Key="PinGlyph">M8,3 L16,3 M9.5,3 L9.5,9 L6,13 L18,13 L14.5,9 L14.5,3 M12,13 L12,21</StreamGeometry>

        <!-- A pinned project: the same tile, with its pin in the corner to pull out. The pin is
             faint until the pointer is on the tile, and turns red and struck through over itself,
             so it reads as what a click will do rather than as a label. Laid over the tile rather
             than inside it: a button inside the tile's own button would open the project too. -->
        <DataTemplate x:Key="PinnedTile">
            <Grid x:Name="Root" Background="Transparent">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProjectTile}" />
                <Button x:Name="UnpinButton" Width="34" Height="34" Margin="0,0,14,6"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Opacity="0.45"
                        Click="OnUnpin" Tag="{Binding Path}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Unpin {0}}"
                        ToolTip="Unpin - take it off the start page. The file stays where it is.">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Disc" Fill="#FFEFF5FF" Stroke="#FFB8D2F0" StrokeThickness="1" />
                                <Path x:Name="Pin" Data="{StaticResource PinGlyph}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="#FF2F6FD0" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="Tilt" Angle="35" />
                                    </Path.RenderTransform>
                                </Path>
                                <Line x:Name="Slash" X1="10" Y1="24" X2="24" Y2="10" Opacity="0"
                                      Stroke="#FFD0453A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Disc" Property="Fill" Value="#FFFDECEA" />
                                    <Setter TargetName="Disc" Property="Stroke" Value="#FFE8A49C" />
                                    <Setter TargetName="Pin" Property="Stroke" Value="#FFD0453A" />
                                    <Setter TargetName="Slash" Property="Opacity" Value="1" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Tilt" Storyboard.TargetProperty="Angle"
                                                                 To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Tilt" Storyboard.TargetProperty="Angle"
                                                                 To="35" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Disc" Property="Fill" Value="#FFF8D3CE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="UnpinButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="3DFastCraft" FontSize="20" FontWeight="SemiBold" Foreground="#FF23303C" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="New project" MinWidth="130" Padding="12,6" Margin="0,0,10,0" Click="OnNew"
                    AutomationProperties.AutomationId="StartNew" IsDefault="True" />
            <Button Content="Open a file..." MinWidth="130" Padding="12,6" Click="OnOpen"
                    AutomationProperties.AutomationId="StartOpen" />
        </StackPanel>

        <TextBlock x:Name="PinnedHeader" Text="Pinned" FontWeight="SemiBold" Foreground="#FF33383F" Margin="0,0,0,6" />
        <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource PinnedTile}" AutomationProperties.AutomationId="StartPinned" />

        <TextBlock x:Name="RecentHeader" Text="Recent" FontWeight="SemiBold" Foreground="#FF33383F" Margin="0,8,0,6" />
        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ProjectTile}" AutomationProperties.AutomationId="StartRecent" />

        <CheckBox x:Name="ShowBox" Content="Show this when 3DFastCraft starts" Margin="0,12,0,0"
                  AutomationProperties.AutomationId="StartShow" />
    </StackPanel>
</Window>
