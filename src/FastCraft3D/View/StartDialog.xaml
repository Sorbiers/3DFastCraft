<Window x:Class="FastCraft3D.View.StartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3DFastCraft" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#FFF7F7F8">

    <Window.Resources>
        <!-- A project to open: its picture, read lazily, and its name, with the folder under it. -->
        <DataTemplate x:Key="ProjectTile">
            <Button Click="OnProject" Tag="{Binding Path}" ToolTip="{Binding Path}" Margin="0,0,0,6" Padding="6"
                    HorizontalContentAlignment="Stretch" Background="#FFFFFFFF" BorderBrush="#FFD8DBE0"
                    AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="64" Height="64" Margin="0,0,12,0" CornerRadius="3"
                            Background="#FFEEF0F3" BorderBrush="#FFD8DBE0" BorderThickness="1">
                        <Image Source="{Binding Picture}" Stretch="Uniform" Margin="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF23303C" />
                        <TextBlock Text="{Binding Folder}" Foreground="#FF7A8088" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="3DFastCraft" FontSize="20" FontWeight="SemiBold" Foreground="#FF23303C" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="New project" MinWidth="130" Padding="12,6" Margin="0,0,10,0" Click="OnNew"
                    AutomationProperties.AutomationId="StartNew" IsDefault="True" />
            <Button Content="Open a file..." MinWidth="130" Padding="12,6" Click="OnOpen"
                    AutomationProperties.AutomationId="StartOpen" />
        </StackPanel>

        <TextBlock x:Name="PinnedHeader" Text="Favorites" FontWeight="SemiBold" Foreground="#FF33383F" Margin="0,0,0,6" />
        <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource ProjectTile}" AutomationProperties.AutomationId="StartPinned" />

        <TextBlock x:Name="RecentHeader" Text="Recent" FontWeight="SemiBold" Foreground="#FF33383F" Margin="0,8,0,6" />
        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ProjectTile}" AutomationProperties.AutomationId="StartRecent" />

        <CheckBox x:Name="ShowBox" Content="Show this when 3DFastCraft starts" Margin="0,12,0,0"
                  AutomationProperties.AutomationId="StartShow" />
    </StackPanel>
</Window>
