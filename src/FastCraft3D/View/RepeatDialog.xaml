<view:ToolPanel x:Class="FastCraft3D.View.RepeatDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Repeat">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel x:Name="CountRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Copies" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="How many, in addition to the original" />
            <TextBox x:Name="CountBox" Width="56" Style="{DynamicResource NumberBox}" Text="5"
                     AutomationProperties.AutomationId="RepeatCount" TextChanged="OnChanged" />
        </StackPanel>

        <!-- One panel rather than two commands: it is the same idea either way - make N copies,
             arranged - and only the fields below differ. -->
        <!-- Short names, so the three fit across the side panel; the tooltips say the rest. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="LineMode" GroupName="Shape" Content="Line" IsChecked="True"
                         AutomationProperties.AutomationId="RepeatAlongLine"
                         ToolTip="Along a line, each copy a step on from the last"
                         Checked="OnModeChanged" Margin="0,0,14,0" />
            <RadioButton x:Name="RingMode" GroupName="Shape" Content="Circle"
                         AutomationProperties.AutomationId="RepeatRoundCircle"
                         ToolTip="Round a circle on the plate, with a rise per copy for a spiral"
                         Checked="OnModeChanged" Margin="0,0,14,0" />
            <RadioButton x:Name="GridMode" GroupName="Shape" Content="Grid"
                         AutomationProperties.AutomationId="RepeatInGrid"
                         ToolTip="In rows and columns, and layers if asked"
                         Checked="OnModeChanged" />
        </StackPanel>

        <StackPanel x:Name="GridPanel" Visibility="Collapsed">
            <TextBlock Text="How many, the original counted" Foreground="#FF5A5F66" Margin="0,0,0,2" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" />
                <TextBox x:Name="ColumnsBox" Width="54" Style="{DynamicResource NumberBox}" Text="3"
                         AutomationProperties.AutomationId="GridColumns" TextChanged="OnChanged" ToolTip="Columns, along X" />
                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="RowsBox" Width="54" Style="{DynamicResource NumberBox}" Text="3"
                         AutomationProperties.AutomationId="GridRows" TextChanged="OnChanged" ToolTip="Rows, along Y" />
                <TextBlock Text="Z" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="LayersBox" Width="54" Style="{DynamicResource NumberBox}" Text="1"
                         AutomationProperties.AutomationId="GridLayers" TextChanged="OnChanged" ToolTip="Layers, stacked up Z" />
            </StackPanel>

            <TextBlock Text="Spacing (mm)" Foreground="#FF5A5F66" Margin="0,0,0,2" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" />
                <TextBox x:Name="SpacingXBox" Width="54" Style="{DynamicResource NumberBox}" Text="5"
                         AutomationProperties.AutomationId="GridSpacingX" TextChanged="OnChanged" />
                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="SpacingYBox" Width="54" Style="{DynamicResource NumberBox}" Text="5"
                         AutomationProperties.AutomationId="GridSpacingY" TextChanged="OnChanged" />
                <TextBlock Text="Z" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="SpacingZBox" Width="54" Style="{DynamicResource NumberBox}" Text="5"
                         AutomationProperties.AutomationId="GridSpacingZ" TextChanged="OnChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="GapsBox" GroupName="GridSpacing" Content="Gap between" IsChecked="True" Margin="0,0,14,0"
                             Checked="OnChanged" ToolTip="The clear space between neighbours, whatever size they are: a plate of parts to print" />
                <RadioButton x:Name="PitchBox" GroupName="GridSpacing" Content="Centre to centre"
                             Checked="OnChanged" ToolTip="From the middle of one to the middle of the next: a pattern of holes or pegs" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="LinePanel">
            <TextBlock Text="Step between copies (mm)" Foreground="#FF5A5F66" Margin="0,0,0,2" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" />
                <TextBox x:Name="StepXBox" Width="54" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RepeatStepX" TextChanged="OnChanged" />
                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="StepYBox" Width="54" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RepeatStepY" TextChanged="OnChanged" />
                <TextBlock Text="Z" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="StepZBox" Width="54" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RepeatStepZ" TextChanged="OnChanged" />
            </StackPanel>

            <CheckBox x:Name="AnchorBox" AutomationProperties.AutomationId="RepeatAnchor"
                      Margin="0,0,0,8" Click="OnChanged"
                      ToolTip="Growing a box moves both its faces outward. Ticked, the step is measured from the face rather than the middle, which is what stacks a flight of steps.">
                <TextBlock Text="Keep each copy standing where the last one ended" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>

        <StackPanel x:Name="RingPanel" Visibility="Collapsed">
            <TextBlock Text="Copies go round the vertical axis, anticlockwise seen from above."
                       Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Centre" Style="{DynamicResource FieldLabel}" Width="48"
                           ToolTip="The point on the plate the ring turns about." />
                <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" />
                <TextBox x:Name="CentreXBox" Width="56" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RingCentreX" TextChanged="OnChanged" />
                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
                <TextBox x:Name="CentreYBox" Width="56" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RingCentreY" TextChanged="OnChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Radius" Style="{DynamicResource FieldLabel}" Width="62"
                           ToolTip="Filled in from where the selection already stands, so leaving it alone repeats it where it is. Type a different number and the whole ring moves in or out - the original with it, or it would be left off the circle." />
                <TextBox x:Name="RadiusBox" Width="56" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RingRadius" TextChanged="OnChanged" />
                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>

            <CheckBox x:Name="FullTurnBox" Content="Spread evenly over a full turn" IsChecked="True"
                      AutomationProperties.AutomationId="RingFullTurn" Margin="0,4,0,4" Click="OnChanged"
                      ToolTip="Divides 360 by the number of copies plus one, because the original is one of the objects on the circle. Untick to set the angle yourself and sweep an arc instead." />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Angle" Style="{DynamicResource FieldLabel}" Width="62"
                           ToolTip="The angle between one copy and the next" />
                <TextBox x:Name="AngleBox" Width="56" Style="{DynamicResource NumberBox}" Text="60"
                         AutomationProperties.AutomationId="RingAngle" TextChanged="OnChanged" />
                <TextBlock Text="degrees" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rise" Style="{DynamicResource FieldLabel}" Width="62"
                           ToolTip="How much higher each copy is than the one before it. A ring with a rise is a spiral stair." />
                <TextBox x:Name="RiseBox" Width="56" Style="{DynamicResource NumberBox}" Text="0"
                         AutomationProperties.AutomationId="RingRise" TextChanged="OnChanged" />
                <TextBlock Text="mm per copy" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>

            <CheckBox x:Name="FaceBox" Content="Turn each copy to face the centre" IsChecked="True"
                      AutomationProperties.AutomationId="RingFaceCentre" Margin="0,4,0,8" Click="OnChanged"
                      ToolTip="Each copy is turned by the angle it travelled, so it keeps the same face towards the centre - gear teeth, crenellations, the treads of a spiral stair. Untick for a bolt circle: a round hole does not care which way it points." />
        </StackPanel>

        <StackPanel x:Name="GrowPanel">
        <TextBlock Text="Grow each copy by (mm)" Foreground="#FF5A5F66" Margin="0,0,0,2"
                   ToolTip="Each copy is this much larger than the one before it. A staircase is a step and a rise." />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" />
            <TextBox x:Name="GrowXBox" Width="54" Style="{DynamicResource NumberBox}" Text="0"
                     AutomationProperties.AutomationId="RepeatGrowX" TextChanged="OnChanged" />
            <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
            <TextBox x:Name="GrowYBox" Width="54" Style="{DynamicResource NumberBox}" Text="0"
                     AutomationProperties.AutomationId="RepeatGrowY" TextChanged="OnChanged" />
            <TextBlock Text="Z" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="12" Margin="4,0,0,0" />
            <TextBox x:Name="GrowZBox" Width="54" Style="{DynamicResource NumberBox}" Text="0"
                     AutomationProperties.AutomationId="RepeatGrowZ" TextChanged="OnChanged" />
        </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Repeat" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="RepeatAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
