<Window x:Class="FastCraft3D.View.RepeatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repeat" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Copies" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="72" />
            <TextBox x:Name="CountBox" Width="64" Padding="4,3" Text="5"
                     AutomationProperties.AutomationId="RepeatCount" TextChanged="OnChanged" />
            <TextBlock Text="in addition to the original" VerticalAlignment="Center"
                       Foreground="#FF9AA0A8" Margin="8,0,0,0" />
        </StackPanel>

        <!-- One dialog rather than two commands: it is the same idea either way - make N copies,
             arranged - and only the fields below differ. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="LineMode" GroupName="Shape" Content="Along a line" IsChecked="True"
                         AutomationProperties.AutomationId="RepeatAlongLine"
                         Checked="OnModeChanged" Margin="0,0,22,0" />
            <RadioButton x:Name="RingMode" GroupName="Shape" Content="Round a circle"
                         AutomationProperties.AutomationId="RepeatRoundCircle"
                         Checked="OnModeChanged" />
        </StackPanel>

        <StackPanel x:Name="LinePanel">
            <TextBlock Text="Step between copies (mm)" Foreground="#FF5A5F66" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="16" />
                <TextBox x:Name="StepXBox" Width="70" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RepeatStepX" TextChanged="OnChanged" />
                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="16" Margin="10,0,0,0" />
                <TextBox x:Name="StepYBox" Width="70" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RepeatStepY" TextChanged="OnChanged" />
                <TextBlock Text="Z" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="16" Margin="10,0,0,0" />
                <TextBox x:Name="StepZBox" Width="70" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RepeatStepZ" TextChanged="OnChanged" />
            </StackPanel>

            <CheckBox x:Name="AnchorBox" Content="Keep each copy standing where the last one ended"
                      AutomationProperties.AutomationId="RepeatAnchor"
                      Margin="0,0,0,12" Click="OnChanged"
                      ToolTip="Growing a box moves both its faces outward. Ticked, the step is measured from the face rather than the middle, which is what stacks a flight of steps." />
        </StackPanel>

        <StackPanel x:Name="RingPanel" Visibility="Collapsed">
            <TextBlock Text="Copies go round the vertical axis, anticlockwise seen from above."
                       Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Centre" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="132"
                           ToolTip="The point on the plate the ring turns about." />
                <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="14" />
                <TextBox x:Name="CentreXBox" Width="64" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RingCentreX" TextChanged="OnChanged" />
                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="14" Margin="10,0,0,0" />
                <TextBox x:Name="CentreYBox" Width="64" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RingCentreY" TextChanged="OnChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Radius" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="132"
                           ToolTip="Filled in from where the selection already stands, so leaving it alone repeats it where it is. Type a different number and the whole ring moves in or out - the original with it, or it would be left off the circle." />
                <TextBox x:Name="RadiusBox" Width="64" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RingRadius" TextChanged="OnChanged" />
                <TextBlock Text="mm from the centre" VerticalAlignment="Center"
                           Foreground="#FF9AA0A8" Margin="8,0,0,0" />
            </StackPanel>

            <CheckBox x:Name="FullTurnBox" Content="Spread evenly over a full turn" IsChecked="True"
                      AutomationProperties.AutomationId="RingFullTurn" Margin="0,2,0,8" Click="OnChanged"
                      ToolTip="Divides 360 by the number of copies plus one, because the original is one of the objects on the circle. Untick to set the angle yourself and sweep an arc instead." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Angle between copies" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="132" />
                <TextBox x:Name="AngleBox" Width="64" Padding="4,3" Text="60"
                         AutomationProperties.AutomationId="RingAngle" TextChanged="OnChanged" />
                <TextBlock Text="degrees" VerticalAlignment="Center" Foreground="#FF9AA0A8" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Rise per copy" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="132"
                           ToolTip="How much higher each copy is than the one before it. A ring with a rise is a spiral stair." />
                <TextBox x:Name="RiseBox" Width="64" Padding="4,3" Text="0"
                         AutomationProperties.AutomationId="RingRise" TextChanged="OnChanged" />
                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="#FF9AA0A8" Margin="8,0,0,0" />
            </StackPanel>

            <CheckBox x:Name="FaceBox" Content="Turn each copy to face the centre" IsChecked="True"
                      AutomationProperties.AutomationId="RingFaceCentre" Margin="0,2,0,12" Click="OnChanged"
                      ToolTip="Each copy is turned by the angle it travelled, so it keeps the same face towards the centre - gear teeth, crenellations, the treads of a spiral stair. Untick for a bolt circle: a round hole does not care which way it points." />
        </StackPanel>

        <TextBlock Text="Grow each copy by (mm)" Foreground="#FF5A5F66" Margin="0,4,0,4"
                   ToolTip="Each copy is this much larger than the one before it. A staircase is a step and a rise." />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="X" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="16" />
            <TextBox x:Name="GrowXBox" Width="70" Padding="4,3" Text="0"
                     AutomationProperties.AutomationId="RepeatGrowX" TextChanged="OnChanged" />
            <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="16" Margin="10,0,0,0" />
            <TextBox x:Name="GrowYBox" Width="70" Padding="4,3" Text="0"
                     AutomationProperties.AutomationId="RepeatGrowY" TextChanged="OnChanged" />
            <TextBlock Text="Z" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="16" Margin="10,0,0,0" />
            <TextBox x:Name="GrowZBox" Width="70" Padding="4,3" Text="0"
                     AutomationProperties.AutomationId="RepeatGrowZ" TextChanged="OnChanged" />
        </StackPanel>

        <Border Padding="10,8" CornerRadius="3"
                Background="#FFEFF1F4" BorderBrush="#FFDDE0E4" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Repeat" IsDefault="True" Click="OnAccept"
                    AutomationProperties.Name="RepeatAccept"
                    MinWidth="88" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </StackPanel>
</Window>
