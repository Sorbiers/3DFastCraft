<Window x:Class="FastCraft3D.View.DeformDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,12" />

        <StackPanel x:Name="AxisRow" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Towards" VerticalAlignment="Center" Foreground="#FF5A5F66" Margin="0,0,10,0" />
            <RadioButton x:Name="AxisX" Content="X" GroupName="DeformAxis" IsChecked="True" Margin="0,0,14,0"
                         Checked="OnAxisChanged" />
            <RadioButton x:Name="AxisY" Content="Y" GroupName="DeformAxis" Checked="OnAxisChanged" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="ValueLabel" VerticalAlignment="Center" Foreground="#FF5A5F66" Margin="0,0,8,0" />
            <TextBox x:Name="ValueBox" Width="64" Padding="4,3" HorizontalContentAlignment="Right"
                     TextChanged="OnValueTyped" AutomationProperties.AutomationId="DeformValue" />
            <TextBlock x:Name="UnitText" VerticalAlignment="Center" Foreground="#FF9AA0A8" Margin="6,0,0,0" />
        </StackPanel>

        <Slider x:Name="ValueSlider" IsSnapToTickEnabled="True" ValueChanged="OnValueDragged" />

        <Grid Margin="0,2,0,0">
            <TextBlock x:Name="LowText" Foreground="#FF9AA0A8" FontSize="11" HorizontalAlignment="Left" />
            <TextBlock x:Name="HighText" Foreground="#FF9AA0A8" FontSize="11" HorizontalAlignment="Right" />
        </Grid>

        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="#FFB3261E" Margin="0,10,0,0" Visibility="Collapsed" />

        <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="3"
                Background="#FFEFF1F4" BorderBrush="#FFDDE0E4" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AcceptButton" IsDefault="True" Click="OnAccept"
                    MinWidth="88" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </StackPanel>
</Window>
