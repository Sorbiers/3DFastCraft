<view:ToolPanel x:Class="FastCraft3D.View.DeformDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel x:Name="AxisRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Towards" Style="{DynamicResource FieldLabel}" Width="62" />
            <RadioButton x:Name="AxisX" Content="X" GroupName="DeformAxis" IsChecked="True" Margin="0,0,14,0"
                         VerticalAlignment="Center" Checked="OnAxisChanged" />
            <RadioButton x:Name="AxisY" Content="Y" GroupName="DeformAxis" VerticalAlignment="Center"
                         Checked="OnAxisChanged" />
        </StackPanel>

        <DockPanel>
            <TextBlock x:Name="ValueLabel" Style="{DynamicResource FieldLabel}" Width="62" />
            <TextBox x:Name="ValueBox" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnValueTyped" AutomationProperties.AutomationId="DeformValue" />
            <TextBlock x:Name="UnitText" VerticalAlignment="Center" Foreground="#FF9AA0A8" TextWrapping="Wrap" />
        </DockPanel>

        <Slider x:Name="ValueSlider" IsSnapToTickEnabled="True" ValueChanged="OnValueDragged" Margin="0,4,0,0" />

        <Grid Margin="0,2,0,0">
            <TextBlock x:Name="LowText" Foreground="#FF9AA0A8" FontSize="11" HorizontalAlignment="Left" />
            <TextBlock x:Name="HighText" Foreground="#FF9AA0A8" FontSize="11" HorizontalAlignment="Right" />
        </Grid>

        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="#FFB3261E" Margin="0,8,0,0" Visibility="Collapsed" />

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Style="{DynamicResource PanelButton}" Click="OnAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</view:ToolPanel>
