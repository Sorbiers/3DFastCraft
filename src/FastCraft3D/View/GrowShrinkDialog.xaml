<view:ToolPanel x:Class="FastCraft3D.View.GrowShrinkDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Grow">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="GrowChoice" GroupName="GrowShrink" Content="Grow" Margin="0,0,14,0"
                         AutomationProperties.AutomationId="Grow" Checked="OnModeChanged" />
            <RadioButton x:Name="ShrinkChoice" GroupName="GrowShrink" Content="Shrink"
                         AutomationProperties.AutomationId="Shrink" Checked="OnModeChanged" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="By" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="How far every face moves, out to grow and in to shrink" />
            <TextBox x:Name="DistanceBox" Width="64" Style="{DynamicResource NumberBox}"
                     AutomationProperties.AutomationId="GrowShrinkDistance" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Along" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Which ways the faces move. Leave Z out to keep the height: top and bottom stay, the walls move." />
            <CheckBox x:Name="AlongX" Content="X" Margin="0,0,12,0" AutomationProperties.AutomationId="AlongX" />
            <CheckBox x:Name="AlongY" Content="Y" Margin="0,0,12,0" AutomationProperties.AutomationId="AlongY" />
            <CheckBox x:Name="AlongZ" Content="Z" AutomationProperties.AutomationId="AlongZ" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="#FF5A5F66" Margin="0,4,0,0">
            Every face moves by the same amount, so walls get thicker or thinner and gaps narrower or
            wider - not a scale, which would move the gaps as well. More than a part is wide cannot
            be shrunk away and is refused.
        </TextBlock>

        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FFB3261E" Margin="0,6,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Content="Grow" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.AutomationId="AcceptButton" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</view:ToolPanel>
