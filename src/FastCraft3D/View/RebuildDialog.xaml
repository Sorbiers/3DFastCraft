<view:ToolPanel x:Class="FastCraft3D.View.RebuildDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Rebuild">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF5A5F66" Margin="0,0,0,8" />

        <RadioButton x:Name="ShapeChoice" GroupName="RebuildMode" Margin="0,0,0,4" FontWeight="SemiBold"
                     AutomationProperties.AutomationId="KeepShape" Checked="OnModeChanged"
                     Content="Keep the shape" />
        <StackPanel x:Name="ShapePanel" Margin="20,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,6">
                Keeps only the corners: points in the middle of flat faces and along straight edges go,
                and every flat face is filled again from its outline. Faces with holes are left as they are.
            </TextBlock>
            <CheckBox x:Name="MergeBox" Margin="0,0,0,4" AutomationProperties.AutomationId="MergeNearlyFlat"
                      Content="Merge faces that are flat to within 0.01 mm" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF5A5F66" Margin="20,0,0,0">
                For walls joined from parts or cut a little past an edge, which come out as two faces a
                hair apart. The surface can move by up to 0.01 mm. Off, nothing moves by more than 0.001 mm.
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <CheckBox x:Name="EvenBox" Content="Even triangles, about" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="EvenTriangles" Checked="OnEvenChanged" Unchecked="OnEvenChanged" />
                <TextBox x:Name="EvenSizeBox" Width="48" Margin="6,0,4,0" Style="{DynamicResource NumberBox}"
                         AutomationProperties.AutomationId="EvenSize" TextChanged="OnEvenChanged" />
                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="EvenText" TextWrapping="Wrap" Foreground="#FF5A5F66" Margin="20,0,0,0" />
        </StackPanel>

        <RadioButton x:Name="ScratchChoice" GroupName="RebuildMode" Margin="0,0,0,4" FontWeight="SemiBold"
                     AutomationProperties.AutomationId="FromScratch" Checked="OnModeChanged"
                     Content="From scratch" />
        <StackPanel x:Name="ScratchPanel" Margin="20,0,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8">
                Rebuilds the surface from scratch by working out what is inside the model and what is
                outside, rather than by mending the triangles. It fixes anything - including a model
                whose surface passes through itself, which nothing else here can touch.
            </TextBlock>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Detail" Style="{DynamicResource FieldLabel}" Width="62"
                           ToolTip="Voxels across the model. The smallest feature that survives is one voxel." />
                <TextBox x:Name="ResolutionBox" Width="64" Style="{DynamicResource NumberBox}"
                         TextChanged="OnResolutionTyped" />
                <TextBlock Text="voxels" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>

            <Slider x:Name="ResolutionSlider" TickFrequency="8" IsSnapToTickEnabled="True"
                    ValueChanged="OnResolutionDragged" Margin="0,4,0,0" />

            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                    Background="#FFFFF6E8" BorderBrush="#FFE8C88A" BorderThickness="1">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FF6B4E12" />
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Rebuild" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.AutomationId="AcceptButton" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</view:ToolPanel>
