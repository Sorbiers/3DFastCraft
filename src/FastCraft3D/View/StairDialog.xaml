<view:ToolPanel x:Class="FastCraft3D.View.StairDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Stair">

    <StackPanel>
        <TextBlock Text="A straight flight, arriving level with the floor above."
                   TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Rise" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="Floor to floor" />
            <TextBox x:Name="RiseBox" Width="64" Style="{DynamicResource NumberBox}" Text="26.5"
                     AutomationProperties.AutomationId="StairRise" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Run" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="How far it travels along the floor" />
            <TextBox x:Name="RunBox" Width="64" Style="{DynamicResource NumberBox}" Text="37.7"
                     AutomationProperties.AutomationId="StairRun" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Width" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="Across the flight" />
            <TextBox x:Name="WidthBox" Width="64" Style="{DynamicResource NumberBox}" Text="14"
                     AutomationProperties.AutomationId="StairWidth" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Steps" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="Risers, the last of them onto the floor above" />
            <TextBox x:Name="StepsBox" Width="64" Style="{DynamicResource NumberBox}" Text="13"
                     AutomationProperties.AutomationId="StairSteps" TextChanged="OnChanged" />
            <TextBlock Text="risers" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Insert" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="StairAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
