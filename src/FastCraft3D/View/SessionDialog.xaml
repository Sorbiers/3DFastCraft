<Window x:Class="FastCraft3D.View.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session" Height="560" Width="760" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFF7F7F8">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HeaderText" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,10" />

        <ListBox x:Name="StepList" Grid.Row="1" SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnListDoubleClick" AutomationProperties.AutomationId="SessionSteps">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#FF2C3037"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FF767C85" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The plate after the step chosen, drawn when it is chosen. -->
        <Border Grid.Row="1" Grid.Column="1" Width="260" Height="260" Margin="14,0,0,0" VerticalAlignment="Top"
                CornerRadius="3" Background="#FFEEF0F3" BorderBrush="#FFD8DBE0" BorderThickness="1">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="PreviewNote" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FF9AA0A8" TextWrapping="Wrap" TextAlignment="Center" Margin="16" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#FF767C85"
                   Text="Going back replaces what is on the plate. It is a normal undo step, so Ctrl+Z brings the current model back." />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ForgetButton" Content="Forget older steps" Click="OnForget"
                    MinWidth="80" Padding="10,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SessionForget"
                    ToolTip="Make the project file smaller: forget every step before the one chosen. This cannot be undone." />
            <Button x:Name="GoBackButton" Content="Go back to this step" IsDefault="True" Click="OnGoBack"
                    MinWidth="92" Padding="10,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SessionGoBack" />
            <Button Content="Close" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </Grid>
</Window>
