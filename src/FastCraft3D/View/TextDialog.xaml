<view:ToolPanel x:Class="FastCraft3D.View.TextDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Text">

    <StackPanel>
        <TextBlock Text="Lettering as an object of its own: a sign, a name tag, a keychain. The preview is on the plate. To put letters on a face that is already there, use Emboss or Engrave."
                   TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <TextBox x:Name="TextBox" Padding="4,3" Margin="0,0,0,6" FontSize="14" TextChanged="OnChanged"
                 AutomationProperties.AutomationId="TextObjectText" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Font" Style="{DynamicResource FieldLabel}" Width="62" />
            <!-- Each name followed by the lettering in that font, as Emboss shows it. The sample is
                 read from the box's Tag, which carries what is typed. -->
            <ComboBox x:Name="FontBox" Width="180" SelectionChanged="OnFontChanged"
                      Tag="{Binding Text, ElementName=TextBox}"
                      AutomationProperties.AutomationId="TextObjectFont">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FontName" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock x:Name="FontSample" Visibility="Collapsed" Margin="12,0,0,0"
                                       FontFamily="{Binding}" FontSize="16" MaxWidth="240"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=False}"
                                         Value="True">
                                <Setter TargetName="FontSample" Property="Visibility" Value="Visible" />
                                <Setter TargetName="FontName" Property="Width" Value="190" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox x:Name="BoldBox" Content="Bold" Margin="0,0,16,0" Click="OnClicked" />
            <CheckBox x:Name="ItalicBox" Content="Italic" Click="OnClicked" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Height" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="How tall the capitals stand" />
            <TextBox x:Name="HeightBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="TextObjectHeight" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Depth" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="How thick the letters are" />
            <TextBox x:Name="DepthBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="TextObjectDepth" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Spacing" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Added after every letter; below nought draws them closer" />
            <TextBox x:Name="SpacingBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="TextObjectSpacing" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Laid out" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="In a line, or bent round a circle or a cylinder." />
            <ComboBox x:Name="LayoutBox" Width="180" SelectedIndex="0" SelectionChanged="OnLayoutChanged"
                      AutomationProperties.AutomationId="TextObjectLayout">
                <ComboBoxItem Content="In a line, lying flat" ToolTip="The letters lie on the plate and read from above - how most lettering prints best." />
                <ComboBoxItem Content="In a line, standing up" ToolTip="The letters stand up to read from the front." />
                <ComboBoxItem Content="Round a circle" ToolTip="Lying on the plate, bent round a circle - a clock face, a coaster, a ring of words. The middle of the lettering sits at the top and it runs anticlockwise." />
                <ComboBoxItem Content="Round a cylinder" ToolTip="Standing up, wrapped round a cylinder - a cup, a napkin ring, a barrel label. Across is measured along the surface, so a letter keeps its width whatever the radius." />
            </ComboBox>
        </StackPanel>

        <StackPanel x:Name="RadiusRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Radius" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="To the feet of the letters, so they stand outside it. The circle a 30 mm radius draws is 60 mm across and 188 mm round." />
            <TextBox x:Name="RadiusBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="TextObjectRadius" />
            <TextBlock x:Name="RadiusText" Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="InwardRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Width="62" />
            <CheckBox x:Name="InwardBox" Content="Facing in, round the bottom" Click="OnClicked"
                      AutomationProperties.AutomationId="TextObjectInward"
                      ToolTip="Off, the lettering stands outward from the middle and runs round the top of the circle. On, it stands inward and runs round the bottom - the two halves of a badge or a seal. Either way it reads the right way up from above." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="Add" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="TextObjectAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
