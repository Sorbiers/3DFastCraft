<view:ToolPanel x:Class="FastCraft3D.View.KitSprueDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Kit sprue">

    <view:ColumnFlow>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Clearance" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Free space between each part and the runners round it" />
            <TextBox x:Name="ClearanceBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueClearance" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Runners" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of the runners between the parts, and of the stubs that lead to the gates" />
            <TextBox x:Name="RunnerBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueRunner" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Frame" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of the frame round the outside. Wider than a runner, it keeps the whole sprue flat on the plate." />
            <TextBox x:Name="FrameBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueFrame" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Height" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Height of the frame and runners on the plate" />
            <TextBox x:Name="HeightBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueHeight" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Gate width" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of a gate where it meets the part - what is cut. A few nozzle widths holds a part and still snips cleanly." />
            <TextBox x:Name="GateWidthBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueGateWidth" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Gate height" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Height of a gate where it meets the part, from the plate up. Low, so its scar is at the foot of the part." />
            <TextBox x:Name="GateHeightBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueGateHeight" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Width" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="How wide the sprue may grow before the parts go on to a new row" />
            <TextBox x:Name="WidthBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="SprueWidth" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox x:Name="CornersBox" Content="Gates at the corners" Margin="0,0,0,8" Click="OnCornersClicked"
                  AutomationProperties.AutomationId="SprueCorners"
                  ToolTip="A gate by each end of every straight side instead of one in the middle, so the frame holds down the corners that lift first. A round part is still held from the middle." />

        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="3"
                Background="#FFEFF5FF" BorderBrush="#FFB8D2F0" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF33383F" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Content="Make sprue" Style="{DynamicResource PanelButton}" Click="OnAccept" IsEnabled="False" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </view:ColumnFlow>
</view:ToolPanel>
