<view:ToolPanel x:Class="FastCraft3D.View.DistributeDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Distribute">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Gap" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="The distance between neighboring objects, and between one row and the next" />
            <TextBox x:Name="GapBox" view:Units.Length="True" Width="56" Style="{DynamicResource NumberBox}" Tag="number"
                     AutomationProperties.AutomationId="DistributeGap" TextChanged="OnChanged" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox x:Name="BestFaceBox" Content="Best face down" Margin="0,8,0,0" Checked="OnChanged" Unchecked="OnChanged"
                  AutomationProperties.AutomationId="DistributeBestFace"
                  ToolTip="Turn each object onto the face that prints best - the least to support - before setting it out. Each is judged on its own." />
        <CheckBox x:Name="DropBox" Content="Drop to plate" Margin="0,4,0,0" IsChecked="True" Checked="OnChanged" Unchecked="OnChanged"
                  AutomationProperties.AutomationId="DistributeDrop"
                  ToolTip="Stand each object on the plate. Off, an object keeps its height. Always on with Best face down, which stands each part on its face." />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Distribute" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="DistributeAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
