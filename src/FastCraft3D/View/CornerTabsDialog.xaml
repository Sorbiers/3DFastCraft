<view:ToolPanel x:Class="FastCraft3D.View.CornerTabsDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Corner tabs">

    <view:ColumnFlow>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <TextBlock Text="Corners" Style="{DynamicResource FieldLabel}" Margin="0,0,0,2" />
        <RadioButton x:Name="FoundRadio" GroupName="Which" Content="The sharp corners, found" IsChecked="True" Margin="0,0,0,2"
                     Checked="OnChoiceChanged" AutomationProperties.AutomationId="TabsFound"
                     ToolTip="Every corner of the foot that turns 45 degrees or more - a box's four, an L's five outside ones. A gentle curve is not a corner." />
        <RadioButton x:Name="ByHandRadio" GroupName="Which" Content="Picked by hand" Margin="0,0,0,8"
                     Checked="OnChoiceChanged" AutomationProperties.AutomationId="TabsByHand"
                     ToolTip="Click a corner of the part in the view to put tabs on it, or take them off. Starts from the corners found." />

        <TextBlock Text="Tabs at each corner" Style="{DynamicResource FieldLabel}" Margin="0,0,0,2" />
        <RadioButton x:Name="TwoRadio" GroupName="PerCorner" Content="Two, one off each side" IsChecked="True" Margin="0,0,0,2"
                     Checked="OnChoiceChanged" AutomationProperties.AutomationId="TabsTwo"
                     ToolTip="A tab off each of the two sides that meet at the corner, just short of it: the corner is held both ways, and the cut is on a flat side." />
        <RadioButton x:Name="OneRadio" GroupName="PerCorner" Content="One, out of the point" Margin="0,0,0,8"
                     Checked="OnChoiceChanged" AutomationProperties.AutomationId="TabsOne"
                     ToolTip="One tab straight out of the point of the corner. Half as many to cut, and the scar is on the corner itself." />

        <CheckBox x:Name="FrameBox" Content="Frame round the part" IsChecked="True" Margin="0,0,0,8" Click="OnChoiceChanged"
                  AutomationProperties.AutomationId="TabsFrame"
                  ToolTip="Every tab runs out to a stiff frame round the part, which holds them all flat. Without it, each tab ends in a pad of its own." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Reach" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="How far the tabs stand out from the part: to the frame, or to the pad" />
            <TextBox x:Name="ReachBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsReach" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="FrameWidthRow" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Frame" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of the frame. Wider than a tab, it keeps the whole thing flat on the plate." />
            <TextBox x:Name="FrameWidthBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsFrameWidth" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="PadRow" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Pad" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of the round pad at the end of each tab, which holds it to the plate. Nought for none." />
            <TextBox x:Name="PadBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsPad" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Tab width" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of a tab, from the gate out" />
            <TextBox x:Name="WidthBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsWidth" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Height" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Height of the tabs, pads and frame on the plate. Several layers, so a tab does not curl up with the corner." />
            <TextBox x:Name="HeightBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsHeight" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Gate width" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Width of a gate where it meets the part - what is cut. A few nozzle widths holds the corner and still snips cleanly." />
            <TextBox x:Name="GateWidthBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsGateWidth" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Gate height" Style="{DynamicResource FieldLabel}" Width="78"
                       ToolTip="Height of a gate where it meets the part, from the plate up. Low, so its scar is at the foot of the part." />
            <TextBox x:Name="GateHeightBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnChanged" AutomationProperties.AutomationId="TabsGateHeight" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="3"
                Background="#FFEFF5FF" BorderBrush="#FFB8D2F0" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF33383F" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Content="Add tabs" Style="{DynamicResource PanelButton}" Click="OnAccept" IsEnabled="False" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </view:ColumnFlow>
</view:ToolPanel>
