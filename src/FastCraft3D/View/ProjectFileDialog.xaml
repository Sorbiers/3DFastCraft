<Window x:Class="FastCraft3D.View.ProjectFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#FFF7F7F8">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Keep a project file?" FontSize="15" FontWeight="SemiBold" Foreground="#FF23303C" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8">
            Beside the project's .3mf, 3DFastCraft can keep a .3dfp of the same name - a second copy of
            the project that no slicer opens. If a slicer saves over the .3mf and drops the project
            from it, the .3dfp brings it back. It also keeps the view as you left it.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Foreground="#FF7A8088" Margin="0,0,0,12">
            You still open and save the .3mf as always. The .3dfp can be deleted at any time.
        </TextBlock>
        <CheckBox x:Name="RememberBox" Content="Remember my choice for new projects" Margin="0,0,0,4"
                  AutomationProperties.AutomationId="ProjectFileRemember" />
        <TextBlock Text="Changed later in File &gt; Project." Foreground="#FF7A8088" FontSize="11" Margin="20,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Keep a project file" MinWidth="130" Padding="12,5" Margin="0,0,8,0" IsDefault="True"
                    Click="OnKeep" AutomationProperties.AutomationId="ProjectFileKeep" />
            <Button Content="Just the .3mf" MinWidth="110" Padding="12,5" IsCancel="True"
                    Click="OnPlain" AutomationProperties.AutomationId="ProjectFilePlain" />
        </StackPanel>
    </StackPanel>
</Window>
