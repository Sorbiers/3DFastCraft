<Window x:Class="FastCraft3D.View.SvgImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import drawing" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Width" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="86" />
            <TextBox x:Name="WidthBox" Width="70" Padding="4,3" TextChanged="OnWidthTyped"
                     AutomationProperties.AutomationId="SvgWidth" />
            <TextBlock Text="mm, along X" VerticalAlignment="Center" Foreground="#FF9AA0A8" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Depth" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="86" />
            <TextBox x:Name="DepthBox" Width="70" Padding="4,3" TextChanged="OnDepthTyped"
                     AutomationProperties.AutomationId="SvgDepth" />
            <TextBlock Text="mm, along Y - keeps the drawing's proportions" VerticalAlignment="Center"
                       Foreground="#FF9AA0A8" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Thickness" VerticalAlignment="Center" Foreground="#FF5A5F66" Width="86" />
            <TextBox x:Name="ThicknessBox" Width="70" Padding="4,3" TextChanged="OnThicknessTyped"
                     AutomationProperties.AutomationId="SvgThickness" />
            <TextBlock Text="mm, standing up off the plate" VerticalAlignment="Center" Foreground="#FF9AA0A8" Margin="8,0,0,0" />
        </StackPanel>

        <CheckBox x:Name="SeparateBox" Content="One object per shape"
                  ToolTip="Each filled shape in the drawing becomes an object of its own, to colour or move apart. Off, the whole drawing is one object." />

        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="3"
                Background="#FFEFF1F4" BorderBrush="#FFDDE0E4" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Import" IsDefault="True" Click="OnAccept"
                    MinWidth="88" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </StackPanel>
</Window>
