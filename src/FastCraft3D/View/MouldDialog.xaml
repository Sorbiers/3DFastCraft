<view:ToolPanel x:Class="FastCraft3D.View.MouldDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Mould">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <Border Padding="8,6" CornerRadius="3" Margin="0,0,0,8"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="AdviceText" TextWrapping="Wrap" Foreground="#FF2C3037" />
                <TextBlock x:Name="AxisText" TextWrapping="Wrap" Foreground="#FF5A5F66"
                           FontSize="11" Margin="0,6,0,0" />
                <TextBlock x:Name="RouteText" TextWrapping="Wrap" Foreground="#FF3A4550"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Pieces" Style="{DynamicResource FieldLabel}" Width="62" />
            <ComboBox x:Name="PiecesBox" Width="56" SelectionChanged="OnChanged"
                      AutomationProperties.AutomationId="MouldPieces" />
            <TextBlock x:Name="PiecesHint" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#FF9AA0A8" Margin="6,0,0,0" />
        </DockPanel>

        <DockPanel x:Name="DetailRow" Margin="0,0,0,4">
            <TextBlock Text="Detail" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="How finely the model is sampled. Only used when it is too heavy to cut exactly." />
            <ComboBox x:Name="DetailBox" Width="80" SelectionChanged="OnChanged"
                      AutomationProperties.AutomationId="MouldDetail" />
            <TextBlock x:Name="DetailHint" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#FF9AA0A8" Margin="6,0,0,0" />
        </DockPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Wall" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Material between the model and the outside of the block." />
            <TextBox x:Name="WallBox" Width="56" Style="{DynamicResource NumberBox}" Text="8"
                     AutomationProperties.AutomationId="MouldWall" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Pour hole" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Across. Silicone is thick and slow, so a generous hole is worth the material." />
            <TextBox x:Name="SprueBox" Width="56" Style="{DynamicResource NumberBox}" Text="10"
                     AutomationProperties.AutomationId="MouldSprue" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Air vents" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Across. Thin holes at every pocket that would otherwise hold a bubble." />
            <TextBox x:Name="VentBox" Width="56" Style="{DynamicResource NumberBox}" Text="2"
                     AutomationProperties.AutomationId="MouldVent" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            <CheckBox x:Name="VentsBox" Content="add them" IsChecked="True" Margin="10,0,0,0"
                      VerticalAlignment="Center" Click="OnChanged"
                      AutomationProperties.AutomationId="MouldAddVents" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Keys" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Registration keys, across: a dome on one face of every joint and a socket in the other, so the pieces close one way round only. Zero leaves the faces plain." />
            <TextBox x:Name="KeyBox" Width="56" Style="{DynamicResource NumberBox}" Text="8"
                     AutomationProperties.AutomationId="MouldKey" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Clearance" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Room between a key and its socket" />
            <TextBox x:Name="ClearanceBox" Width="56" Style="{DynamicResource NumberBox}" Text="0.20"
                     AutomationProperties.AutomationId="MouldKeyClearance" TextChanged="OnChanged" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Make mould" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="MouldAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
