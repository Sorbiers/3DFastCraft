<view:ToolPanel x:Class="FastCraft3D.View.FillDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Fill up">

    <view:ColumnFlow>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Fill level" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="How high it is filled. At the top it is filled to the brim; lower, it stops at that height, as liquid poured to a line would." />
            <TextBox x:Name="LevelBox" view:Units.Length="True" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnLevelTyped" AutomationProperties.AutomationId="FillLevel" />
            <TextBlock Text="mm" view:Units.Label="True" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <Slider x:Name="LevelSlider" ValueChanged="OnLevelDragged" Margin="0,4,0,8" />

        <CheckBox x:Name="PlateBox" Content="The plate is a floor" Margin="0,0,0,6" Click="OnPlateClicked"
                  AutomationProperties.AutomationId="FillPlate"
                  ToolTip="Nothing drains down through the plate, so a tube, a ring or walls standing on it fill as a cup does. The fill stands flat on the plate." />
        <CheckBox x:Name="ApartBox" Content="Keep as its own part" Margin="0,0,0,8" Click="OnApartClicked"
                  AutomationProperties.AutomationId="FillApart"
                  ToolTip="The fill as a separate object, fitting the inside exactly - to print in another filament, or to see how much a cavity holds. Off: the part is filled solid." />

        <DockPanel>
            <TextBlock Text="Detail" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="Voxels along the part's longest side. The part keeps its own surface; this is how finely the fill finds its way into corners." />
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="#FF33383F" TextWrapping="Wrap" />
        </DockPanel>
        <Slider x:Name="DetailSlider" Minimum="60" Maximum="240" TickFrequency="20"
                IsSnapToTickEnabled="True" ValueChanged="OnDetailDragged" Margin="0,4,0,8" />

        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="3"
                Background="#FFEFF5FF" BorderBrush="#FFB8D2F0" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF33383F" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Content="Fill" Style="{DynamicResource PanelButton}" Click="OnAccept" IsEnabled="False" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </view:ColumnFlow>
</view:ToolPanel>
