<view:ToolPanel x:Class="FastCraft3D.View.BestFaceDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Best face down">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <TextBlock Text="Favour" Style="{DynamicResource FieldLabel}" HorizontalAlignment="Left" Margin="0,0,0,4" />
        <ComboBox x:Name="FavourBox" Margin="0,0,0,10" SelectedIndex="0"
                  SelectionChanged="OnFavourChanged"
                  AutomationProperties.AutomationId="BestFaceFavour"
                  ToolTip="What to weigh most. Support is usually the one that matters - it is the material, the time and the scar it leaves when it is broken off.">
            <ComboBoxItem Content="Less support" />
            <ComboBoxItem Content="Shorter print" />
            <ComboBoxItem Content="Firmer footing" />
        </ComboBox>

        <ItemsControl x:Name="ChoiceList" AutomationProperties.AutomationId="BestFaceChoices">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,0,4" Padding="8,6" HorizontalContentAlignment="Stretch"
                            Background="{Binding Shade}" BorderBrush="#FFD5DEEA" BorderThickness="1"
                            Click="OnPick" MouseEnter="OnHover" MouseLeave="OnLeave"
                            Tag="{Binding}" ToolTip="{Binding Hint}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}" Foreground="#FF6B7480"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="#FF23303C" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" Foreground="#FF5A6472" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</view:ToolPanel>
