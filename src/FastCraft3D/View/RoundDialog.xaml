<view:ToolPanel x:Class="FastCraft3D.View.RoundDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Round edges">

    <StackPanel>
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <TextBlock Text="Which edges" Foreground="#FF5A5F66" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="EdgeTop" Content="Top" IsChecked="True" Margin="0,0,14,0"
                      Checked="OnEdgesChanged" Unchecked="OnEdgesChanged" />
            <CheckBox x:Name="EdgeBottom" Content="Bottom" IsChecked="True" Margin="0,0,14,0"
                      Checked="OnEdgesChanged" Unchecked="OnEdgesChanged" />
            <CheckBox x:Name="EdgeSides" Content="Sides" IsChecked="True"
                      Checked="OnEdgesChanged" Unchecked="OnEdgesChanged" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Radius" Style="{DynamicResource FieldLabel}" Width="62" />
            <TextBox x:Name="RadiusBox" Width="64" Style="{DynamicResource NumberBox}"
                     TextChanged="OnRadiusTyped" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <Slider x:Name="RadiusSlider" Minimum="0" TickFrequency="0.5" IsSnapToTickEnabled="False"
                ValueChanged="OnRadiusDragged" Margin="0,4,0,0" />
        <TextBlock x:Name="MaximumText" Foreground="#FF9AA0A8" FontSize="11" HorizontalAlignment="Right" />

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Round" Style="{DynamicResource PanelButton}" Click="OnAccept" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</view:ToolPanel>
