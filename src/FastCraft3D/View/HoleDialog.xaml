<view:ToolPanel x:Class="FastCraft3D.View.HoleDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:view="clr-namespace:FastCraft3D.View"
                Title="Hole">

    <StackPanel>
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8" />

        <WrapPanel Margin="0,0,0,6">
            <RadioButton x:Name="ScrewBox" GroupName="HoleKind" Content="Screw hole" Margin="0,0,14,0" Checked="OnChoice"
                         AutomationProperties.AutomationId="HoleScrew" />
            <RadioButton x:Name="InsertBox" GroupName="HoleKind" Content="Heat-set insert" Checked="OnChoice"
                         AutomationProperties.AutomationId="HoleInsert"
                         ToolTip="A pocket for a brass threaded insert pressed in with a soldering iron - a thread that survives being undone many times" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Size" Style="{DynamicResource FieldLabel}" Width="62" />
            <ComboBox x:Name="SizeBox" Width="80" SelectionChanged="OnSizeChanged"
                      AutomationProperties.AutomationId="HoleSize" />
        </StackPanel>

        <StackPanel x:Name="ScrewPanel">
            <WrapPanel Margin="0,2,0,4">
                <RadioButton x:Name="PlainBox" GroupName="HoleHead" Content="Plain" Margin="0,0,12,0" Checked="OnChoice"
                             ToolTip="The head sits on the surface" />
                <RadioButton x:Name="CountersunkBox" GroupName="HoleHead" Content="Countersunk" Margin="0,0,12,0" Checked="OnChoice"
                             ToolTip="A 90 degree cone, so a countersunk (flat) head sits flush" />
                <RadioButton x:Name="CounterboredBox" GroupName="HoleHead" Content="Counterbored" Checked="OnChoice"
                             ToolTip="A wider step, so a socket cap head sits below the surface" />
            </WrapPanel>
            <CheckBox x:Name="NutBox" Content="Nut pocket at the far end" Margin="0,0,0,6" Click="OnClicked"
                      AutomationProperties.AutomationId="HoleNut"
                      ToolTip="A hexagon pocket for the nut, so it is held while the screw is turned" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Depth" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="How deep the hole goes below the surface" />
                <TextBox x:Name="DepthBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                         AutomationProperties.AutomationId="HoleDepth" />
                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="ThroughBox" Content="All the way through" Margin="0,2,0,6" Click="OnClicked"
                      AutomationProperties.AutomationId="HoleThrough"
                      ToolTip="Long enough to go right through the part, whichever way the cutter points" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Clearance" Style="{DynamicResource FieldLabel}" Width="62"
                           ToolTip="Added to every diameter, as printed holes come out small. Not added to an insert's pocket, which should be tight." />
                <TextBox x:Name="ClearanceBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                         AutomationProperties.AutomationId="HoleClearance" />
                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
            <TextBlock Text="Holes" Style="{DynamicResource FieldLabel}" Width="62"
                       ToolTip="How many, set out round the handles: moving or turning the cutter moves them all" />
            <TextBox x:Name="CountBox" Width="44" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="HoleCount" />
            <RadioButton x:Name="RowBox" GroupName="HolePattern" Content="Row" Margin="10,0,10,0" VerticalAlignment="Center" Checked="OnChoice"
                         AutomationProperties.AutomationId="HoleRow"
                         ToolTip="In a line along the cutter's own X, centred on the handles" />
            <RadioButton x:Name="CircleBox" GroupName="HolePattern" Content="Circle" VerticalAlignment="Center" Checked="OnChoice"
                         AutomationProperties.AutomationId="HoleCircle"
                         ToolTip="Evenly round a circle centred on the handles: a bolt circle" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Spacing" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="From the middle of one hole to the next, in a row" />
            <TextBox x:Name="SpacingBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="HoleSpacing" />
            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Circle" Style="{DynamicResource FieldLabel}" Width="62" ToolTip="Across the circle the holes' middles lie on" />
            <TextBox x:Name="CircleDiameterBox" Width="60" Style="{DynamicResource NumberBox}" Tag="number" TextChanged="OnChanged"
                     AutomationProperties.AutomationId="HoleCircleDiameter" />
            <TextBlock Text="mm across" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Content="Cut" Style="{DynamicResource PanelButton}" Click="OnAccept"
                    AutomationProperties.Name="HoleAccept"
                    ToolTip="Take the holes out of the part now, where the cutter stands" />
            <Button x:Name="AddButton" Content="Add" Style="{DynamicResource PanelButton}" Click="OnAdd"
                    AutomationProperties.Name="HoleAdd"
                    ToolTip="Put the cutter on the plate where it stands, to Subtract later - from this part or another" />
            <Button Content="Cancel" Style="{DynamicResource PanelButton}" IsCancel="True" />
        </StackPanel>

        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                Background="White" BorderBrush="#FFD5DEEA" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FF3A3F45" />
        </Border>
    </StackPanel>
</view:ToolPanel>
