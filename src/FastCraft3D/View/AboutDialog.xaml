<Window x:Class="FastCraft3D.View.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About 3DFastCraft" SizeToContent="Height" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">
    <StackPanel Margin="20,16,20,14">

        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconCube}" Stroke="#FF1A73E8" StrokeThickness="1.4"
                  Width="34" Height="34" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="3DFastCraft" FontSize="19" FontWeight="SemiBold" Foreground="#FF23272C" />
                <TextBlock x:Name="VersionLine" Foreground="#FF6A7078" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,14,0,0"
                   Text="A small, offline replacement for the retired Microsoft 3D Builder: drop in shapes, size them exactly, cut and combine them, and export a printable STL. Millimetres, Z-up, everything on one plate." />

        <Border Background="#FFEDEEF0" CornerRadius="4" Padding="12,9" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="CopyrightLine" Foreground="#FF33383F" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" Foreground="#FF5A5F66" FontSize="12" Margin="0,6,0,0"
                           Text="Proprietary licence - the source is readable, but it may not be used commercially or redistributed. See LICENSE in the repository for the terms that govern it." />
                <TextBlock TextWrapping="Wrap" Foreground="#FF5A5F66" FontSize="12" Margin="0,6,0,0"
                           Text="Built on HelixToolkit and SharpDX, each under its own MIT licence - listed in THIRD-PARTY-NOTICES.md." />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,12,0,0">
            <Hyperlink NavigateUri="https://github.com/Sorbiers/3DFastCraft"
                       RequestNavigate="OnNavigate">github.com/Sorbiers/3DFastCraft</Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy details" Click="OnCopy" MinWidth="96" Padding="10,6" Margin="0,0,8,0"
                    ToolTip="Version and build, for a bug report" />
            <Button Content="Close" IsDefault="True" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </StackPanel>
</Window>
