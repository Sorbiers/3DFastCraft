<Window x:Class="FastCraft3D.View.VersionNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save a version" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F8">
    <StackPanel Margin="18,14,18,14">
        <TextBlock TextWrapping="Wrap" Foreground="#FF33383F" Margin="0,0,0,10"
                   Text="Name this version so you can find your way back to it later." />
        <TextBox x:Name="LabelBox" Padding="5,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save version" IsDefault="True" Click="OnAccept"
                    MinWidth="102" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6" />
        </StackPanel>
    </StackPanel>
</Window>
