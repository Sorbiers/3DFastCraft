<Application x:Class="FastCraft3D.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Every tooltip, wrapped. A tooltip given as plain text is laid out on one line
                 however long it is, and the longer ones ran the full width of the screen. -->
            <Style TargetType="ToolTip">
                <Setter Property="MaxWidth" Value="420" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
