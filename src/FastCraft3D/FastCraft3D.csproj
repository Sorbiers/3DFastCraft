<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- The Windows 10 target framework is what turns on the WinRT projections, and the mesh
         repair engine the app falls back on lives there (Geometry/WindowsRepair.cs). It is only
         which headers are visible: the floor below keeps the app running on 1809, where that
         engine has been present since long before. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>FastCraft3D</RootNamespace>
    <AssemblyName>3DFastCraft</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- A beta: the generator library is new. The stable 3.3.0 stays the site's download. -->
    <Version>4.0.0-beta</Version>
    <Product>3DFastCraft</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.SharpDX.Core.Wpf" Version="2.27.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastCraft3D.Geometry\FastCraft3D.Geometry.csproj" />
    <ProjectReference Include="..\FastCraft3D.Generators\FastCraft3D.Generators.csproj" />
  </ItemGroup>

  <!-- The Visual C++ runtime manifold_rs.dll links against. Self-contained .NET does not supply
       it - WPF ships its own renamed copy, vcruntime140_cor3.dll - and without it Manifold does
       not load, so lettering quietly falls back to the BSP engine. Beside the exe it is packed and
       extracted with the other native libraries, and Windows finds it in the folder the library
       that needs it was loaded from. -->
  <ItemGroup>
    <None Include="Native\vcruntime140.dll" Link="vcruntime140.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
