<Window x:Class="FastCraft3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:view="clr-namespace:FastCraft3D.View"
        Title="{Binding WindowTitle}" Height="900" Width="1500"
        Background="#FFF3F3F3" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnFilesDraggedOver" Drop="OnFilesDropped">

    <Window.Resources>
        <!-- Ribbon button: icon over label. The icon geometry travels in Tag, so adding one to
             a button is a single attribute rather than a nested StackPanel each time. -->
        <!-- Buttons inside the side panels. The ribbon style keeps a square for an icon
             above the label, and a panel button has no icon to put there - so it came out
             half again as tall as it needed to be with a gap where the picture should be. -->
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF2C3037" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="#FFF7FAFF" BorderThickness="1"
                                BorderBrush="#FFBCCADC" CornerRadius="3" Padding="10,4">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE7EDF5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD3E0EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFA8AEB6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFDCE2EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF2C3037" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="4" Padding="8,5" Margin="1">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}" Width="22" Height="22"
                                      Stretch="Uniform" Fill="{x:Null}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      SnapsToDevicePixels="True" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                           Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE7EDF5" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFBCCADC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD3E0EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ribbon tabs: rounded tops, a little larger, with the selected one joined to the
             panel below it. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FF4A5058" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Margin="2,3,2,0" Padding="18,8"
                                CornerRadius="7,7,0,0" Background="Transparent"
                                BorderThickness="1,1,1,0" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#FFEDF2F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#FFFAFAFB" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#FFD8DBE0" />
                                <Setter Property="Foreground" Value="#FF1D5FA8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <!-- Overlap the panel border so the tab reads as part of it. -->
                                <Setter TargetName="Tab" Property="Margin" Value="2,1,2,-1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A label with more to say is underlined with dots and shows the help cursor; one
             without stays plain. Decided by whether the label has a tooltip at all, so a label
             given one later is marked without anyone remembering to. -->
        <TextDecorationCollection x:Key="HintUnderline">
            <TextDecoration Location="Underline" PenOffset="1.5">
                <TextDecoration.Pen>
                    <Pen Brush="#FFA5ABB3" Thickness="1">
                        <Pen.DashStyle>
                            <DashStyle Dashes="1,2" />
                        </Pen.DashStyle>
                    </Pen>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#FF5A5F66" />
            <Setter Property="TextDecorations" Value="{StaticResource HintUnderline}" />
            <Setter Property="Cursor" Value="Help" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ToolTip, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="TextDecorations" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,4,2" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- Same look as a ribbon button, but it stays pressed while it is on. -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF2C3037" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="4" Padding="8,5" Margin="1">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}" Width="22" Height="22"
                                      Stretch="Uniform" Fill="{x:Null}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      SnapsToDevicePixels="True" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                           Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE7EDF5" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFBCCADC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD3E0EF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF8FAFD0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The eye and the lock on a row of the object list: faint until they mean something. -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFDCE6F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF2F6FB6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF33373D" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <!-- Folded away when there is not one object selected: its DataContext is then null. -->
        <Style x:Key="OneObjectOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <view:ColourToBrushConverter x:Key="ColourToBrush" />
        <view:OutlinesToGeometryConverter x:Key="OutlinesToGeometry" />

        <!-- A palette swatch: the colour itself is the whole button, so the grid reads as paint
             rather than as a row of controls. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderBrush" Value="#FFB9BEC5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF33383F" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFDCE4EE" />
                    <Setter Property="BorderBrush" Value="#FF9AA7B6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The same look as ModeButton, for the buttons in the bar that do something once
             rather than staying on. A style cannot be shared between the two: ModeButton targets
             ToggleButton, and WPF refuses it on a plain Button at runtime. -->
        <Style x:Key="ModeAction" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEDF1F6" />
                    <Setter Property="BorderBrush" Value="#FFC2CBD6" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GizmoLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,3,0" />
            <Setter Property="Foreground" Value="#FF767C85" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- X, Y and Z in the colours of the handles and the lines on the plate, so a box and the
             arrow it drives are read as the same thing. W, D and H are the sizes along them. -->
        <Style x:Key="GizmoLabelX" TargetType="TextBlock" BasedOn="{StaticResource GizmoLabel}">
            <Setter Property="Foreground" Value="#FFD8404F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GizmoLabelY" TargetType="TextBlock" BasedOn="{StaticResource GizmoLabel}">
            <Setter Property="Foreground" Value="#FF229B48" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GizmoLabelZ" TargetType="TextBlock" BasedOn="{StaticResource GizmoLabel}">
            <Setter Property="Foreground" Value="#FF2C86D8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GizmoUnit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,2,0" />
            <Setter Property="Foreground" Value="#FF9AA0A8" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Selection menu. Disabled entries stay visible but greyed, as in 3D Builder, so the
             menu never changes shape and you can see what an action needs. -->
        <Style x:Key="MenuIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#FF44494F" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,9,0" />
        </Style>

        <Style x:Key="MenuLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF33383F" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="SelectionMenuItem" TargetType="ButtonBase">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="3,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE4E9F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionMenuToggle" TargetType="ToggleButton" BasedOn="{StaticResource SelectionMenuItem}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFD8E2F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuChevron" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GizmoBox" TargetType="TextBox">
            <Setter Property="Width" Value="50" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="BorderBrush" Value="#FFD5D9DE" />
        </Style>

        <!-- A box that reads off several objects: blank with a quiet "mixed" when they differ.
             Not a 0, which is a value and invites typing over it as though it were true. -->
        <view:MixedNumberConverter x:Key="Mixed" />
        <Style x:Key="GizmoMixedBox" TargetType="TextBox" BasedOn="{StaticResource GizmoBox}">
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Text" Value="" />
                        <Condition Property="IsKeyboardFocused" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Right">
                                <VisualBrush.Visual>
                                    <TextBlock Text="mixed " Foreground="#FFA0A6AE" FontStyle="Italic" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Keys are bound from View/Shortcuts, the same table F1 lists. -->

    <Grid>
    <DockPanel>

        <!-- Ribbon -->
        <!-- Standing down while a tool has the object: see MainViewModel.IsToolInHand. Buttons
             bound to IsAdvancedMode are the ones 3D Builder never had, left out in Classic. -->
        <TabControl DockPanel.Dock="Top" Background="#FFFAFAFB" BorderThickness="0,0,0,1"
                    IsEnabled="{Binding NothingInHand}"
                    BorderBrush="#FFD8DBE0" Padding="6">
            <TabControl.Resources>
                <!-- A separator between groups of buttons, standing upright. WPF's own draws a
                     horizontal line, which in a row of buttons has no width to show in, so every
                     separator on the ribbon was there and none could be seen. -->
                <Style TargetType="Separator">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Width="1" Margin="0,8" Background="#FFC8CCD2" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Insert">
                <WrapPanel Margin="4">
                    <Button Style="{StaticResource ToolButton}" Content="Cube" Tag="{StaticResource IconCube}"
                            Command="{Binding InsertCommand}" CommandParameter="Cube" />
                    <Button Style="{StaticResource ToolButton}" Content="Cylinder" Tag="{StaticResource IconCylinder}"
                            Command="{Binding InsertCommand}" CommandParameter="Cylinder" />
                    <Button Style="{StaticResource ToolButton}" Content="Cone" Tag="{StaticResource IconCone}"
                            Command="{Binding InsertCommand}" CommandParameter="Cone" />
                    <Button Style="{StaticResource ToolButton}" Content="Sphere" Tag="{StaticResource IconSphere}"
                            Command="{Binding InsertCommand}" CommandParameter="Sphere" />
                    <Button Style="{StaticResource ToolButton}" Content="Pyramid" Tag="{StaticResource IconPyramid}"
                            Command="{Binding InsertCommand}" CommandParameter="Pyramid" />
                    <Button Style="{StaticResource ToolButton}" Content="Wedge" Tag="{StaticResource IconWedge}"
                            Command="{Binding InsertCommand}" CommandParameter="Wedge" />
                    <Button Style="{StaticResource ToolButton}" Content="Torus" Tag="{StaticResource IconTorus}"
                            Command="{Binding InsertCommand}" CommandParameter="Torus" />
                    <Button Style="{StaticResource ToolButton}" Content="Hexagon" Tag="{StaticResource IconHexagon}"
                            Command="{Binding InsertCommand}" CommandParameter="Hexagon" />
                    <Button Style="{StaticResource ToolButton}" Content="Tetrahedron" Tag="{StaticResource IconTetrahedron}"
                            Command="{Binding InsertCommand}" CommandParameter="Tetrahedron" />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Custom" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconCustom}"
                            Command="{Binding InsertCustomCommand}" MinWidth="70"
                            ToolTip="A cube, cylinder, cone, sphere or torus with its size, segments and roundness chosen before it is made - more segments for a smoother shape" />
                    <Button Style="{StaticResource ToolButton}" Content="Text" Tag="{StaticResource IconText3D}"
                            Command="{Binding InsertTextCommand}" MinWidth="58"
                            ToolTip="Lettering as an object of its own - a sign, a name tag, a keychain - in any installed font, lying on the plate or standing up. To put letters on a face that is already there, use Emboss or Engrave." />
                    <Button Style="{StaticResource ToolButton}" Content="Lithophane" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconLithophane}"
                            Command="{Binding InsertLithophaneCommand}" MinWidth="86"
                            ToolTip="BETA - new, and still being proved out; check what it gives you before printing it. A photograph as a thin translucent plate: thin where the picture is white, thick where it is dark, so it shows only when it is lit from behind. Flat, or curved round for a lamp shade." />
                    <Button Style="{StaticResource ToolButton}" Content="Sketch" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconSketchLine}"
                            Command="{Binding BeginSketchCommand}" MinWidth="64"
                            ToolTip="Draw an outline on the plate - lines, arcs, smooth curves, freehand, rectangles, circles - and extrude or revolve it into a solid. Seen from above; Escape or Done when finished." />
                    <Button Style="{StaticResource ToolButton}" Content="Import" Tag="{StaticResource IconImport}"
                            Command="{Binding ImportCommand}" ToolTip="Bring in an STL, an OBJ, or another 3DFastCraft project - its objects join what is already on the plate (Ctrl+I)" />
                    <Separator Margin="8,0" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource ToolButton}" Content="Fit test" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconFitTest}"
                            Command="{Binding InsertFitTestCommand}" MinWidth="64"
                            ToolTip="Four small 2x2 brick plates at Fit -0.2, -0.1, 0 and +0.1 mm, marked with one to four notches, each with studs on top and the underside below. Print them in your filament and press each onto real bricks. Without real bricks, stack one plate on another: the pair grips like the sum of their two Fits. To test two printed halves exactly as Split with connectors makes them - the same Fit on both - print the set twice and try each plate on its twin. Type the Fit that holds firmly but still comes apart by hand." />
                    <Button Style="{StaticResource ToolButton}" Content="Hole" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconHole}"
                            Command="{Binding InsertHoleCommand}" MinWidth="58"
                            ToolTip="A screw hole - plain, countersunk or counterbored, with a nut pocket if asked - or a heat-set insert pocket, M2 to M8. Cut into the top of the one part selected, or made as a cutter to place and Subtract." />
                    <Button Style="{StaticResource ToolButton}" Content="Thread" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconThread}"
                            Command="{Binding InsertThreadCommand}" MinWidth="70"
                            ToolTip="A threaded rod, a nut, or a cutter to Subtract for a threaded hole: ISO metric M3 to M20 or any diameter and pitch, with a clearance so a printed rod and nut screw together" />
                    <Button Style="{StaticResource ToolButton}" Content="Stair" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconStair}"
                            Command="{Binding InsertStairCommand}" MinWidth="70"
                            ToolTip="A straight flight, built as one solid, with the riser and going reported in real units" />
                    <Button Style="{StaticResource ToolButton}" Content="Gear" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconGear}"
                            Command="{Binding InsertGearCommand}" MinWidth="64"
                            ToolTip="An involute gear, ring gear or rack - straight, helical or herringbone - with a bore, a hub and a set-screw hole, and a partner made already in mesh with it" />
                </WrapPanel>
            </TabItem>

            <!-- Object: what a thing is made of. Edit changes its surface, Align says where it
                 sits - the three used to be mixed, with Drop to plate and Mirror filed under
                 Object and Smooth under it too. -->
            <!-- Edit: everything that changes the selection, from a boolean down to a colour.
                 Object was a tab of its own and the split never held up - Subtract belonged with
                 Merge, and both belonged with Smooth and Simplify, which are the same question
                 asked of the surface rather than of the solid. -->
            <TabItem Header="Edit">
                <WrapPanel Margin="4">
                    <Button Style="{StaticResource ToolButton}" Content="Undo" Tag="{StaticResource IconUndo}"
                            Command="{Binding UndoCommand}"
                            ToolTip="{Binding UndoLabel, StringFormat='{}{0} (Ctrl+Z)'}" />
                    <Button Style="{StaticResource ToolButton}" Content="Redo" Tag="{StaticResource IconRedo}"
                            Command="{Binding RedoCommand}" ToolTip="Redo what was undone (Ctrl+Y)" />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Copy" Tag="{StaticResource IconCopy}"
                            Command="{Binding CopyCommand}"
                            ToolTip="Copy the selection (Ctrl+C). Paste puts it back exactly where it came from." />
                    <Button Style="{StaticResource ToolButton}" Content="Cut" Tag="{StaticResource IconCut}"
                            Command="{Binding CutCommand}"
                            ToolTip="Copy the selection and take it away (Ctrl+X). One undo step puts it back." />
                    <Button Style="{StaticResource ToolButton}" Content="Paste" Tag="{StaticResource IconPaste}"
                            Command="{Binding PasteCommand}"
                            ToolTip="Put the clipboard back exactly where it was taken from (Ctrl+V) - which means a paste can land inside the thing it was copied from. Use Duplicate for a copy set beside the original." />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Duplicate" Tag="{StaticResource IconDuplicate}"
                            Command="{Binding DuplicateCommand}"
                            ToolTip="Copy the selection and set it beside the original (Ctrl+D)" />
                    <Button Style="{StaticResource ToolButton}" Content="In place" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconDuplicate}"
                            Command="{Binding DuplicateCommand}" CommandParameter="InPlace" MinWidth="64"
                            ToolTip="Copy the selection without moving it - what you want before a boolean or a mirror (Ctrl+Shift+D)" />
                    <Button Style="{StaticResource ToolButton}" Content="Delete" Tag="{StaticResource IconDelete}"
                            Command="{Binding DeleteCommand}"
                            ToolTip="Remove the selection (Del)" />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Subtract" Tag="{StaticResource IconSubtract}"
                            Command="{Binding BeginSubtractCommand}" MinWidth="80"
                            ToolTip="Take the last object picked away from everything picked before it. Each of those is cut on its own and stays a separate object. Opens the options on the right: a tolerance, and whether to keep the cutter. Needs two or more objects selected, the cutter picked last." />
                    <Button Style="{StaticResource ToolButton}" Content="Intersect" Tag="{StaticResource IconIntersect}"
                            Command="{Binding BooleanCommand}" CommandParameter="Intersect"
                            ToolTip="Keep only the overlapping volume. Needs two or more objects selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Merge" Tag="{StaticResource IconMerge}"
                            Command="{Binding BooleanCommand}" CommandParameter="Union"
                            ToolTip="Fuse the selection into one solid. Needs two or more objects selected." />

                    <Button Style="{StaticResource ToolButton}" Content="Split" Tag="{StaticResource IconSplit}"
                            Command="{Binding BeginSplitCommand}"
                            ToolTip="Cut the selected object in two with a plane, or with a face you pick" />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Set pivot" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconPivot}"
                            Command="{Binding SetPivotCommand}" MinWidth="80"
                            ToolTip="Click a point on the object to measure and turn it about - a shaft hole, a corner, a hinge line. The position boxes then read that point, a turn goes round it, and lining it up with another part compares it rather than the middle of its box. Kept with the project. Needs exactly one object selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Pivot to centre" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconPivotCentre}"
                            Command="{Binding PivotToCentreCommand}" MinWidth="104"
                            ToolTip="Puts the pivot back in the middle of the object's box, where it starts out. Needs exactly one object selected." />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Round" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconRound}"
                            Command="{Binding RoundCommand}" MinWidth="82"
                            ToolTip="Round the edges of a cube or cylinder. Only shapes still described by their parameters can be rounded. Needs a cube or cylinder that has not been cut or reshaped since it was inserted." />
                    <Button Style="{StaticResource ToolButton}" Content="Twist" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconTwist}"
                            Command="{Binding TwistCommand}" MinWidth="70"
                            ToolTip="Turn a shape about its upright axis by more the higher up it goes - twisted columns, vases and spirals. The bottom stays put." />
                    <Button Style="{StaticResource ToolButton}" Content="Taper" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconTaper}"
                            Command="{Binding TaperCommand}" MinWidth="70"
                            ToolTip="Narrow or widen a shape towards the top - tapered columns, spires, flared vases. The bottom keeps its size." />
                    <Button Style="{StaticResource ToolButton}" Content="Bend" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconBend}"
                            Command="{Binding BendCommand}" MinWidth="70"
                            ToolTip="Curve a shape over as if round a pipe, towards X or Y - arches, horns, hooks. The bottom stays put." />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Simplify" Tag="{StaticResource IconSimplify}"
                            Command="{Binding SimplifyCommand}" MinWidth="82"
                            ToolTip="Cut the triangle count down while keeping the shape. The natural partner to Rebuild." />
                    <Button Style="{StaticResource ToolButton}" Content="Smooth" Tag="{StaticResource IconSmooth}"
                            Command="{Binding SmoothCommand}"
                            ToolTip="Round the facets off, with the result shown as you set it" />
                    <Button Style="{StaticResource ToolButton}" Content="Hollow" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconHollow}"
                            Command="{Binding HollowCommand}" MinWidth="78"
                            ToolTip="Turn a solid into a shell of a chosen wall thickness, to save material" />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Colour" Tag="{StaticResource IconColour}"
                            Command="{Binding PickColourCommand}" MinWidth="78"
                            ToolTip="Paint the selection. The palette in the right-hand panel is one click." />
                </WrapPanel>
            </TabItem>

            <TabItem Header="Align">
                <WrapPanel Margin="4">
                    <Button Style="{StaticResource ToolButton}" Content="Drop to plate" Tag="{StaticResource IconDropToPlate}"
                            Command="{Binding AlignToPlateCommand}" MinWidth="90"
                            ToolTip="Set the selection down on z = 0, so it is standing on the bed rather than floating over it" />
                    <Button Style="{StaticResource ToolButton}" Content="Lay on face" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconLayOnFace}"
                            Command="{Binding BeginLayCommand}" MinWidth="86"
                            ToolTip="Pick a face and the object is tipped over to stand on it - the flat side down, for printing. Needs exactly one object selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Align to" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconAlignCentre}"
                            Command="{Binding AlignToSelectionCommand}" MinWidth="72"
                            ToolTip="Move the first object you picked so its bounding box is centred on the second's. Two objects: the first moves, the second stays. Nothing is rotated or resized. Needs exactly two objects selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Align to face" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconAlignToFace}"
                            Command="{Binding BeginAlignFaceCommand}" MinWidth="86"
                            ToolTip="Pick a face on any object, then choose for X, Y and Z whether the selection's near edge, middle or far edge should land on the middle of that face. The whole selection moves together, keeping its own arrangement - nothing is rotated or resized." />
                    <Separator Margin="8,0" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource ToolButton}" Content="Fit" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconFitBed}"
                            Command="{Binding FitToBedCommand}" MinWidth="58"
                            AutomationProperties.Name="Fit to bed"
                            ToolTip="Shrink the selection to fit the printable area, 20 mm clear of the edge, and stand it in the middle of the bed. Only shrinks what is too big - nothing is ever made bigger. The size and height come from View, Grid." />
                    <Button Style="{StaticResource ToolButton}" Content="Distribute" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconArrangeBed}"
                            Command="{Binding DistributeOnBedCommand}" MinWidth="72"
                            AutomationProperties.Name="Distribute on bed"
                            ToolTip="Set the selected objects out in rows across the bed, a gap you choose apart, standing on it. Needs two or more objects selected." />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Mirror X" Tag="{StaticResource IconMirror}"
                            Command="{Binding MirrorCommand}" CommandParameter="X" />
                    <Button Style="{StaticResource ToolButton}" Content="Mirror Y" Tag="{StaticResource IconMirror}"
                            Command="{Binding MirrorCommand}" CommandParameter="Y" />
                    <Button Style="{StaticResource ToolButton}" Content="Mirror Z" Tag="{StaticResource IconMirror}"
                            Command="{Binding MirrorCommand}" CommandParameter="Z" />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="8,0" />
                    <TextBlock Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Text="X" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="#FF5A5F66" Margin="10,0,4,0" />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Left" Tag="{StaticResource IconAlignMin}"
                            Command="{Binding AlignCommand}" CommandParameter="X:Minimum" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, moves it to the bed's edge." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Centre" Tag="{StaticResource IconAlignCentre}"
                            Command="{Binding AlignCommand}" CommandParameter="X:Centre" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, centres it on the bed." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Right" Tag="{StaticResource IconAlignMax}"
                            Command="{Binding AlignCommand}" CommandParameter="X:Maximum" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, moves it to the bed's edge." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Spread" Tag="{StaticResource IconDistribute}"
                            Command="{Binding AlignCommand}" CommandParameter="X:Distribute" MinWidth="58"
                            ToolTip="Even out the gaps along X, keeping the two outermost objects where they are. Needs two or more objects selected." />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="6,0" />
                    <TextBlock Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Text="Y" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="#FF5A5F66" Margin="10,0,4,0" />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Front" Tag="{StaticResource IconAlignMin}"
                            Command="{Binding AlignCommand}" CommandParameter="Y:Minimum" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, moves it to the bed's edge." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Centre" Tag="{StaticResource IconAlignCentre}"
                            Command="{Binding AlignCommand}" CommandParameter="Y:Centre" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, centres it on the bed." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Back" Tag="{StaticResource IconAlignMax}"
                            Command="{Binding AlignCommand}" CommandParameter="Y:Maximum" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, moves it to the bed's edge." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Spread" Tag="{StaticResource IconDistribute}"
                            Command="{Binding AlignCommand}" CommandParameter="Y:Distribute" MinWidth="58"
                            ToolTip="Even out the gaps along Y, keeping the two outermost objects where they are. Needs two or more objects selected." />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="6,0" />
                    <TextBlock Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Text="Z" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="#FF5A5F66" Margin="10,0,4,0" />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Bottom" Tag="{StaticResource IconAlignMin}"
                            Command="{Binding AlignCommand}" CommandParameter="Z:Minimum" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, moves it to the bed's edge." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Centre" Tag="{StaticResource IconAlignCentre}"
                            Command="{Binding AlignCommand}" CommandParameter="Z:Centre" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, centres it on the bed." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Top" Tag="{StaticResource IconAlignMax}"
                            Command="{Binding AlignCommand}" CommandParameter="Z:Maximum" MinWidth="58"
                            ToolTip="With several selected, moves every other one to match the last picked; with one, moves it to the bed's edge." />
                    <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ToolButton}" Content="Spread" Tag="{StaticResource IconDistribute}"
                            Command="{Binding AlignCommand}" CommandParameter="Z:Distribute" MinWidth="58"
                            ToolTip="Even out the gaps along Z, keeping the two outermost objects where they are. Needs two or more objects selected." />
                </WrapPanel>
            </TabItem>

            <!-- Tools: the ones that answer a question or produce something new from the model,
                 rather than changing the model in front of you. Repair and Rebuild sat on Edit
                 next to Smooth and Round, which are shaping tools; Fit check sat on Align next to
                 the things that move objects, and it moves nothing at all. -->
            <TabItem Header="Tools">
                <WrapPanel Margin="4">
                    <Button Style="{StaticResource ToolButton}" Content="Mould" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconHollow}"
                            Command="{Binding MouldCommand}" MinWidth="76"
                            ToolTip="Make a mould of the selection to pour silicone into: a block with the model taken out of it, cut so the cast part comes out, with a pour hole and air vents. Select one object. Needs exactly one object selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Hull" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconHull}"
                            Command="{Binding HullCommand}"
                            ToolTip="Wrap the selection in one skin, as cling film pulled tight round it: two cylinders make a slot, a row of spheres a rounded bar. Replaces what was selected. Needs something selected." />
                    <Separator Margin="8,0" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource ToolButton}" Content="Repair" Tag="{StaticResource IconRepair}"
                            Command="{Binding RepairCommand}"
                            ToolTip="Mend objects that would not print: fill holes, drop slivers, turn faces the right way round" />
                    <Button Style="{StaticResource ToolButton}" Content="Rebuild" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconRebuild}"
                            Command="{Binding RebuildCommand}" MinWidth="82"
                            ToolTip="Rebuild the surface from scratch. Mends anything, including a model that passes through itself - at the cost of fine detail." />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Voronoi" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconVoronoi}"
                            Command="{Binding VoronoiCommand}" MinWidth="82"
                            ToolTip="BETA - new, and still being proved out; check what it gives you before printing it. Cut the selection into a web of struts along the walls of a Voronoi tessellation - the openwork lamp or vase, or a foam through the inside of a part to take weight out of it. Worked out on a voxel grid, so it comes back watertight; detail finer than a voxel is gone. Needs something selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Extrude down" Tag="{StaticResource IconExtrudeDown}"
                            Command="{Binding BeginExtrudeCommand}" MinWidth="90"
                            ToolTip="Cut the model at a height and carry its outline straight down to a flat base on the plate. For a scan with a ragged bottom, a relief that is only a skin, or a part tilted off its feet." />
                    <Button Style="{StaticResource ToolButton}" Content="Split with connectors" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconSplitConnectors}"
                            Command="{Binding BeginSplitWithConnectorsCommand}" MinWidth="120"
                            ToolTip="Cut a model too big for the plate into two halves that go back together one way only: round pins in holes on both halves, or pegs on one half and sockets in the other." />
                    <Button Style="{StaticResource ToolButton}" Content="Connect objects" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconConnect}"
                            Command="{Binding BeginConnectCommand}" MinWidth="100"
                            ToolTip="Pins or pegs through the face two parts rest against each other on - a floor on its basement, two blocks side by side - so they go together one way only. Select the two parts. Needs exactly two objects selected." />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Emboss" Tag="{StaticResource IconText}"
                            Command="{Binding BeginEmbossCommand}" MinWidth="78"
                            ToolTip="Raise lettering or a drawing off a face, or cut it in. Needs exactly one object selected." />
                    <Button Style="{StaticResource ToolButton}" Content="Engrave" Tag="{StaticResource IconEngrave}"
                            Command="{Binding BeginEngraveCommand}" MinWidth="82"
                            ToolTip="Put brick, roof tiles, planks or grain on one flat face - cut in, or standing proud. Needs exactly one object selected." />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Repeat" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconRepeat}"
                            Command="{Binding RepeatCommand}" MinWidth="76"
                            ToolTip="Repeat the selection along a line or round a circle, growing as it goes - a flight of steps, a row of dowels, a ring of pins, a spiral stair" />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Measure" Tag="{StaticResource IconMeasure}"
                            Command="{Binding BeginMeasureCommand}"
                            ToolTip="Click two points to measure between them, then drag either end to move it" />
                    <Button Style="{StaticResource ToolButton}" Content="Fit check" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconMeasure}"
                            Command="{Binding FitCheckCommand}" MinWidth="72"
                            ToolTip="Measures two parts against each other without changing either: how far they overlap, or how big the gap is. A pin with no hole and a frame too big for its opening both look right on screen. Needs exactly two objects selected." />
                </WrapPanel>
            </TabItem>

            <TabItem Header="File">
                <WrapPanel Margin="4">
                    <Button Style="{StaticResource ToolButton}" Content="New" Tag="{StaticResource IconNew}"
                            Command="{Binding NewCommand}" ToolTip="Start an empty plate (Ctrl+N)" />
                    <Button Style="{StaticResource ToolButton}" Content="Open" Tag="{StaticResource IconOpen}"
                            Command="{Binding OpenCommand}" ToolTip="Open a 3DFastCraft project, replacing what is on the plate (Ctrl+O)" />
                    <Button Style="{StaticResource ToolButton}" Content="Recent" Tag="{StaticResource IconVersions}"
                            Click="OnShowRecent" ToolTip="Projects opened recently">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding RecentFiles}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="ToolTip" Value="{Binding Path}" />
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.OpenRecentCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding Path}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Content="Save" Tag="{StaticResource IconSave}"
                            Command="{Binding SaveCommand}" ToolTip="Save the project (Ctrl+S)" />
                    <Button Style="{StaticResource ToolButton}" Content="Save as" Tag="{StaticResource IconSaveAs}" Command="{Binding SaveAsCommand}" MinWidth="86"
                            ToolTip="Save the project under a new name (Ctrl+Shift+S)" />
                    <Button Style="{StaticResource ToolButton}" Content="Save a version" Tag="{StaticResource IconVersions}"
                            Command="{Binding SaveVersionCommand}" MinWidth="88"
                            ToolTip="Keep a named snapshot inside this project file, so you can come back to it later" />
                    <Button Style="{StaticResource ToolButton}" Content="Versions" Tag="{StaticResource IconVersions}"
                            Command="{Binding VersionsCommand}" MinWidth="82"
                            ToolTip="List the versions kept in this file, and restore one. Needs the project saved to a file first." />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="Export STL / OBJ" Tag="{StaticResource IconExport}"
                            Command="{Binding ExportCommand}" MinWidth="140"
                            ToolTip="Export the selection, or everything when nothing is selected (Ctrl+E)" />
                    <Button Style="{StaticResource ToolButton}" Content="Blueprint" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconDrawing}"
                            Command="{Binding PrintDrawingCommand}" MinWidth="70"
                            AutomationProperties.Name="Blueprint"
                            ToolTip="A blueprint: front, top and right views, and an isometric, with the overall dimensions - to print, or save as a PDF. The selection, or everything when nothing is selected (Ctrl+P)" />
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="About" Tag="{StaticResource IconAbout}"
                            Click="OnAbout" ToolTip="Version, licence and where the source lives" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="Shortcuts" Tag="{StaticResource IconKeyboard}"
                                  IsChecked="{Binding IsShortcutsPanelOpen, Mode=TwoWay}" MinWidth="76"
                                  AutomationProperties.Name="Shortcuts"
                                  ToolTip="Every key the app answers to, and the drags worth knowing (F1)" />
                </WrapPanel>
            </TabItem>

            <TabItem Header="View">
                <WrapPanel Margin="4">
                    <Button Style="{StaticResource ToolButton}" Content="Zoom to fit" Tag="{StaticResource IconZoomFit}" Click="OnZoomExtents" ToolTip="Frame everything on the plate (F)" MinWidth="90" />
                    <Button Style="{StaticResource ToolButton}" Content="Top" Tag="{StaticResource IconViewTop}" Click="OnViewTop" ToolTip="Look from the top (1)" />
                    <Button Style="{StaticResource ToolButton}" Content="Front" Tag="{StaticResource IconViewFront}" Click="OnViewFront" ToolTip="Look from the front (2)" />
                    <Button Style="{StaticResource ToolButton}" Content="Right" Tag="{StaticResource IconViewRight}" Click="OnViewRight" ToolTip="Look from the right (3)" />
                    <Button Style="{StaticResource ToolButton}" Content="Back" Tag="{StaticResource IconViewFront}" Click="OnViewBack" />
                    <Button Style="{StaticResource ToolButton}" Content="Left" Tag="{StaticResource IconViewRight}" Click="OnViewLeft" />
                    <Button Style="{StaticResource ToolButton}" Content="Bottom" Tag="{StaticResource IconViewTop}" Click="OnViewBottom" />
                    <Button Style="{StaticResource ToolButton}" Content="Isometric" Tag="{StaticResource IconViewIso}" Click="OnViewIso" ToolTip="Look from the front right, above (4)" />
                    <Separator Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Margin="8,0" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="Wireframe" Tag="{StaticResource IconWireframe}"
                                  IsChecked="{Binding ShowWireframe}" MinWidth="80"
                                  ToolTip="Draw every triangle edge - useful for seeing how dense an import is" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="X-ray" Tag="{StaticResource IconXray}"
                                  IsChecked="{Binding ShowXray}"
                                  ToolTip="Fade everything that is not selected, to see a part buried inside another. While a tool has the plate to itself - a split, a preview - it also brings the rest back, drawn through rather than taken away" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="Outline" Tag="{StaticResource IconOutline}"
                                  IsChecked="{Binding ShowOutlines}" MinWidth="76"
                                  AutomationProperties.Name="Outline"
                                  ToolTip="The white line round a selected object's own edges. Turn it off on a dense mesh, where it traces every feature edge and covers the surface it is meant to bound" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="Plate" Tag="{StaticResource IconPlate}"
                                  IsChecked="{Binding ShowPlate}"
                                  ToolTip="Show or hide the build plate" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="Overhangs" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}" Tag="{StaticResource IconOverhang}"
                                  IsChecked="{Binding ShowOverhangs, Mode=TwoWay}" MinWidth="76"
                                  AutomationProperties.Name="Overhangs"
                                  ToolTip="Faces that lean further from upright than the angle, marked in colour - what the slicer will want to support. Faces flat on the bed are left out: the bed holds them up. The angle and colour are set in the side panel while this is on." />
                    <ToggleButton Style="{StaticResource ToolToggle}" Content="Grid" Tag="{StaticResource IconGrid}"
                                  IsChecked="{Binding IsGridPanelOpen, Mode=TwoWay}"
                                  AutomationProperties.Name="Grid"
                                  ToolTip="The printable area, and how the axes and distances are drawn on the plate" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Units" Style="{StaticResource FieldLabel}" Margin="8,0,6,0"
                                   ToolTip="What the position and size boxes are read and typed in. Display only: millimetres are what is stored and what is written to an STL, which has no unit of its own and is read as millimetres by every slicer." />
                        <ComboBox Width="64" IsEditable="True" IsReadOnly="True"
                                  ItemsSource="{Binding Units}"
                                  AutomationProperties.AutomationId="MeasureUnit"
                                  SelectedItem="{Binding Unit, Mode=TwoWay}"
                                  ToolTip="Millimetres, centimetres, metres, inches or feet." />

                        <TextBlock Text="Scale 1:" Style="{StaticResource FieldLabel}" Margin="14,0,6,0"
                                   ToolTip="What the model is drawn to. It changes no geometry and no field - the millimetres stay millimetres, because that is what a slicer reads. What it changes is the grey reading beside them, which says what those millimetres come to at this scale." />
                        <!-- SelectionChanged as well as the Text binding: the binding commits on
                             focus loss, which is right while someone is typing "160" and wrong
                             when they pick a row - the scale would sit unchanged until they
                             clicked somewhere else. -->
                        <ComboBox Width="118" IsEditable="True" ItemsSource="{Binding ModelScales}"
                                  AutomationProperties.AutomationId="ModelScale"
                                  SelectionChanged="OnScaleChosen"
                                  Text="{Binding ModelScaleText, UpdateSourceTrigger=LostFocus}"
                                  ToolTip="1:87 is HO, 1:160 is N, 1:12 a dolls' house, 1:1 life size. Select something to see the reading." />
                    </StackPanel>
                </WrapPanel>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFEDEEF0" BorderBrush="#FFD8DBE0" BorderThickness="0,1,0,0">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectionSummary}" Foreground="#FF3A3F45" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Working..." Foreground="#FFB3541E" FontWeight="SemiBold" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Status}" Foreground="#FF5A5F66" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel -->
        <Border DockPanel.Dock="Right" Width="300" Background="#FFFAFAFB"
                BorderBrush="#FFD8DBE0" BorderThickness="1,0,0,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Selection, on the right as the old app had it. Collapsible, and it keeps
                     the state it was left in. -->
                <StackPanel IsEnabled="{Binding NothingInHand}">
                    <ToggleButton Style="{StaticResource MenuChevron}" HorizontalAlignment="Left"
                                  IsChecked="{Binding IsSelectionMenuOpen, Mode=TwoWay}"
                                  ToolTip="Show or hide the selection tools">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,0 L 5,5 L 0,10" Stroke="#FF44494F" StrokeThickness="1.6"
                                  Fill="{x:Null}" Width="8" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <!-- Points right when collapsed, down when expanded. -->
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectionMenuOpen}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Selection" FontWeight="SemiBold" Foreground="#FF33373D"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                <StackPanel Visibility="{Binding IsSelectionMenuOpen,
                                         Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource SelectionMenuItem}" Command="{Binding GroupCommand}"
                            AutomationProperties.Name="Group"
                            ToolTip="Combine the selected objects into one (Ctrl+G). Needs two or more objects selected.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MenuIcon}"
                                  Data="M 1,1 L 11,1 L 11,11 L 1,11 Z M 5,5 L 15,5 L 15,15 L 5,15 Z" />
                            <TextBlock Text="Group" Style="{StaticResource MenuLabel}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SelectionMenuItem}" Command="{Binding UngroupCommand}"
                            AutomationProperties.Name="Ungroup"
                            ToolTip="Split the selection into its separate pieces (Ctrl+Shift+G)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MenuIcon}"
                                  Data="M 0,0 L 7,0 L 7,7 L 0,7 Z M 10,10 L 17,10 L 17,17 L 10,17 Z" />
                            <TextBlock Text="Ungroup" Style="{StaticResource MenuLabel}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Margin="8,4" Fill="#FFDDE0E4" />

                    <Button Style="{StaticResource SelectionMenuItem}" Command="{Binding SelectAllCommand}"
                            AutomationProperties.Name="Select all"
                            ToolTip="Select every object (Ctrl+A)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MenuIcon}"
                                  Data="M 1,1 L 17,1 L 17,17 L 1,17 Z M 5,5 L 13,5 L 13,13 L 5,13 Z" />
                            <TextBlock Text="Select all" Style="{StaticResource MenuLabel}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SelectionMenuItem}" Command="{Binding DeselectAllCommand}"
                            AutomationProperties.Name="Deselect all"
                            ToolTip="Clear the selection (Ctrl+Shift+A)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MenuIcon}"
                                  Data="M 9,1 A 8,8 0 1 1 8.9,1 Z" />
                            <TextBlock Text="Deselect all" Style="{StaticResource MenuLabel}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SelectionMenuItem}" Command="{Binding InvertSelectionCommand}"
                            AutomationProperties.Name="Invert selection"
                            ToolTip="Select everything that is not selected, and vice versa">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MenuIcon}"
                                  Data="M 9,1 A 8,8 0 1 1 8.9,1 Z M 9,1 L 9,17 A 8,8 0 0 0 9,1 Z" />
                            <TextBlock Text="Invert selection" Style="{StaticResource MenuLabel}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Margin="8,4" Fill="#FFDDE0E4" />

                    <ToggleButton Style="{StaticResource SelectionMenuToggle}"
                                  AutomationProperties.Name="Sticky selection"
                                  IsChecked="{Binding StickySelection, Mode=TwoWay}"
                                  ToolTip="On: clicking an object adds or removes just that object, leaving the rest selected">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MenuIcon}"
                                  Data="M 9,1 A 8,8 0 1 1 8.9,1 Z M 9,5 L 14,14 L 4,14 Z" />
                            <TextBlock Text="Sticky selection" Style="{StaticResource MenuLabel}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                    <DockPanel Margin="0,6,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Show all" Style="{StaticResource LinkButton}" Margin="0,0,10,0"
                                    Command="{Binding ShowAllCommand}"
                                    Visibility="{Binding AnyHidden, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Show every hidden object again (Alt+H)" />
                            <Button Content="Unlock all" Style="{StaticResource LinkButton}"
                                    Command="{Binding UnlockAllCommand}"
                                    Visibility="{Binding AnyLocked, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Unlock every locked object (Alt+L)" />
                        </StackPanel>
                        <TextBlock Text="Objects" Style="{StaticResource SectionHeader}" Margin="0" />
                    </DockPanel>
                </StackPanel>

                <!-- Selection is mirrored by SelectionListSync, not by an IsSelected binding:
                     a container generated later would push its initial false into the model. -->
                <view:ObjectListBox x:Name="ObjectList" Grid.Row="1" ItemsSource="{Binding Scene.Objects}"
                                    IsEnabled="{Binding NothingInHand}"
                                    HorizontalContentAlignment="Stretch"
                                    SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Background="Transparent">
                                <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                        Command="{Binding DataContext.ToggleLockedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Lock"
                                        ToolTip="Lock: it stays in view but cannot be selected, so nothing can move or change it (L)">
                                    <Path x:Name="LockIcon" Data="{StaticResource RowUnlocked}" Stroke="#FF33383F" StrokeThickness="1.3"
                                          Fill="{x:Null}" Stretch="Uniform" Width="11" Height="11" Opacity="0.3" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                        Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Hide"
                                        ToolTip="Hide: not drawn, not picked, and left out of Export and Drawing (H)">
                                    <Path x:Name="EyeIcon" Data="{StaticResource RowShown}" Stroke="#FF33383F" StrokeThickness="1.3"
                                          Fill="{x:Null}" Stretch="Uniform" Width="13" Height="11" Opacity="0.3" />
                                </Button>
                                <Button x:Name="ColourDot" DockPanel.Dock="Left" Style="{StaticResource RowIconButton}" Margin="0,0,2,0"
                                        Command="{Binding DataContext.PickObjectColourCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Colour"
                                        ToolTip="Colour: pick one for this object, or for the whole selection when it is part of it">
                                    <Ellipse x:Name="ColourBubble" Width="11" Height="11" Stroke="#40000000" StrokeThickness="1"
                                             Fill="{Binding Colour, Converter={StaticResource ColourToBrush}}" />
                                </Button>
                                <TextBlock x:Name="NameText" Text="{Binding Name}" Padding="2" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="EyeIcon" Property="Data" Value="{StaticResource RowHidden}" />
                                    <Setter TargetName="EyeIcon" Property="Opacity" Value="1" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="#FF9AA0A8" />
                                    <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                    <Setter TargetName="ColourBubble" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter TargetName="LockIcon" Property="Data" Value="{StaticResource RowLocked}" />
                                    <Setter TargetName="LockIcon" Property="Opacity" Value="1" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="#FF9AA0A8" />
                                    <Setter TargetName="ColourDot" Property="IsEnabled" Value="False" />
                                    <Setter TargetName="ColourDot" Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="ColourBubble" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </view:ObjectListBox>

                <!-- Split panel, shown only while a split is being set up. Blue like every other
                     tool's panel; beige is kept for printing advice. -->
                <Border Grid.Row="2" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSplitMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Split with a plane" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Axis" Style="{StaticResource FieldLabel}" />
                            <RadioButton x:Name="SplitAxisX" Content="X" Margin="0,0,8,0" Checked="OnSplitAxisChanged" Tag="X" />
                            <RadioButton x:Name="SplitAxisY" Content="Y" Margin="0,0,8,0" Checked="OnSplitAxisChanged" Tag="Y" />
                            <RadioButton x:Name="SplitAxisZ" Content="Z" IsChecked="True" Checked="OnSplitAxisChanged" Tag="Z" />
                        </StackPanel>
                        <Slider Minimum="{Binding SplitMinimum}" Maximum="{Binding SplitMaximum}"
                                Value="{Binding SplitOffset, Mode=TwoWay}" />
                        <TextBlock Margin="0,0,0,6" Foreground="#FF5A5F66">
                            <Run Text="Offset " /><Run Text="{Binding SplitOffset, StringFormat=N2}" /><Run Text=" mm" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding SplitKeepChoosable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Keep" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="Both" IsChecked="True" Margin="0,0,8,0" Checked="OnSplitKeepChanged" Tag="Both" />
                            <RadioButton Content="{Binding KeepFrontLabel}" Margin="0,0,8,0" Checked="OnSplitKeepChanged" Tag="Front" />
                            <RadioButton Content="{Binding KeepBackLabel}" Checked="OnSplitKeepChanged" Tag="Back" />
                        </StackPanel>

                        <!-- What the half being thrown away looks like meanwhile. Greyed out
                             rather than hidden when both halves are kept, so the panel does not
                             jump about as the Keep buttons are tried. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    IsEnabled="{Binding SplitOffcutApplies}"
                                    Visibility="{Binding SplitKeepChoosable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Off cut" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="Show" GroupName="SplitOffcut" Margin="0,0,8,0"
                                         Checked="OnSplitOffcutChanged" Tag="Shown" />
                            <RadioButton Content="Fade" GroupName="SplitOffcut" Margin="0,0,8,0" IsChecked="True"
                                         Checked="OnSplitOffcutChanged" Tag="Faded" />
                            <RadioButton Content="Hide" GroupName="SplitOffcut"
                                         Checked="OnSplitOffcutChanged" Tag="Hidden" />
                        </StackPanel>

                        <!-- Connectors: shown for Split with connectors from the Tools tab. -->
                        <StackPanel Margin="0,2,0,8"
                                    Visibility="{Binding SplitWithConnectors, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Connectors" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton Content="Separate pins" GroupName="ConnectorStyle" Margin="0,0,10,0"
                                             IsChecked="{Binding ConnectorsArePins, Mode=TwoWay}"
                                             ToolTip="Holes in both halves, and the pins made as parts of their own - printed lying down, so they are strong along their length. A broken pin is a reprint, not a lost half." />
                                <RadioButton Content="Pegs on one half" GroupName="ConnectorStyle" Margin="0,0,10,0"
                                             IsChecked="{Binding ConnectorsArePegs, Mode=TwoWay}"
                                             ToolTip="Pegs standing out of one half, sockets in the other. Nothing loose to lose, but pegs printed standing up are weak across their layers." />
                                <RadioButton Content="Brick studs" GroupName="ConnectorStyle"
                                             IsChecked="{Binding ConnectorsAreBricks, Mode=TwoWay}"
                                             ToolTip="Brick studs on the lower half and a shallow brick underside in the upper, on the 8 mm grid. The halves hold by grip, and each takes real bricks along the join. The grid repeats, so line the edges up by eye." />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                        Visibility="{Binding ConnectorsArePegs, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Peg shape" Style="{StaticResource FieldLabel}" Width="76" />
                                <RadioButton Content="Round" GroupName="SplitPegShape" Margin="0,0,10,0" VerticalAlignment="Center"
                                             IsChecked="{Binding ConnectorPegRound, Mode=TwoWay}"
                                             ToolTip="Round pegs in round sockets. Use two or more: one round peg lets the halves turn on it." />
                                <RadioButton Content="Square" GroupName="SplitPegShape" VerticalAlignment="Center"
                                             IsChecked="{Binding ConnectorPegSquare, Mode=TwoWay}"
                                             ToolTip="Square pegs in square sockets, the size box giving the side. A square peg cannot turn, so even one lines the halves up. Its corners reach further than a round peg, so it keeps a little further from the edge." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                        Visibility="{Binding ConnectorsAreBricks, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Fit" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="How much fatter than standard the studs, and the tubes and walls that grip them, are made - in mm across, on both halves. The two halves add up: at -0.1 each there is about 0.2 mm of play in all. -0.1 suits PLA on a tuned printer, about -0.15 PETG." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         Text="{Binding ConnectorBrickFit, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF7A8088" Margin="0,0,0,6"
                                       Visibility="{Binding ConnectorsAreBricks, Converter={StaticResource BoolToVisibility}}"
                                       Text="Use Fit test on the Insert tab to find your Fit: print the set twice and try each plate on its twin - that is how these two halves will meet." />
                            <StackPanel Visibility="{Binding ConnectorsAreRound, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="Square to cut" GroupName="ConnectorDirection" Margin="0,0,8,0"
                                             IsChecked="{Binding ConnectorsPerpendicular, Mode=TwoWay}"
                                             ToolTip="Square to the cut face, whichever way the plane is turned." />
                                <RadioButton Content="Vertical" GroupName="ConnectorDirection" Margin="0,0,8,0"
                                             IsChecked="{Binding ConnectorsVertical, Mode=TwoWay}"
                                             ToolTip="Straight up and down, so the top half of a tilted cut still lifts straight off. Not on a vertical cut, which they would run along." />
                                <RadioButton Content="Horizontal" GroupName="ConnectorDirection"
                                             IsChecked="{Binding ConnectorsHorizontal, Mode=TwoWay}"
                                             ToolTip="Level, towards the cut, so a half on a leaning cut slides off sideways. Not on a level cut, which they would run along." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="How many" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="At most this many. They go only where there is solid round them, as far apart as they will fit." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectorCount"
                                         Text="{Binding ConnectorCount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding ConnectorSizeLabel}" Style="{StaticResource FieldLabel}" Width="76" />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectorDiameter"
                                         Text="{Binding ConnectorDiameter, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="How far a connector goes into each half." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectorDepth"
                                         Text="{Binding ConnectorDepth, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Clearance" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="Per side, as for Subtract: a 5 mm pin with 0.2 goes into a 5.4 mm hole." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectorClearance"
                                         Text="{Binding ConnectorClearance, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="From edge" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="Material left between a hole and the outside of the part. Pins go out towards the edges until this much is left - further apart registers better, but a thin wall beside a hole can split." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectorEdgeDistance"
                                         Text="{Binding ConnectorEdgeDistance, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Both halves are kept." Foreground="#FF7A8088" Margin="0,4,0,0" />
                        </StackPanel>

                        <CheckBox Content="Close the cut face over" Margin="0,0,0,8"
                                  IsEnabled="{Binding SplitCutFaceApplies}"
                                  IsChecked="{Binding SplitFillsCut, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SplitFillsCut"
                                  ToolTip="Off leaves the cut open, so you can see into the piece - how thick a wall is, or whether anything is in there" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Split" Style="{StaticResource PanelButton}" Command="{Binding ApplySplitCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}" Command="{Binding CancelSplitCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Align-to-face panel, shown only while that tool is running. Shares Split's row:
                     the two never run together. -->
                <Border Grid.Row="2" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsAlignFaceMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Align to a face" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Foreground="#FF5A5F66" Margin="0,0,0,6"
                                   Text="Click a face on any object - it does not have to be part of the selection - then choose how each axis should land on its middle." />
                        <TextBlock Text="{Binding AlignFaceTargetLabel}" FontStyle="Italic" Foreground="#FF5A5F66" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="Leave" GroupName="AlignFaceX" Margin="0,0,8,0" IsChecked="True" Checked="OnAlignFaceModeChanged" Tag="X:None" />
                            <RadioButton Content="Min" GroupName="AlignFaceX" Margin="0,0,8,0" Checked="OnAlignFaceModeChanged" Tag="X:Minimum" />
                            <RadioButton Content="Centre" GroupName="AlignFaceX" Margin="0,0,8,0" Checked="OnAlignFaceModeChanged" Tag="X:Centre" />
                            <RadioButton Content="Max" GroupName="AlignFaceX" Checked="OnAlignFaceModeChanged" Tag="X:Maximum" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Y" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="Leave" GroupName="AlignFaceY" Margin="0,0,8,0" IsChecked="True" Checked="OnAlignFaceModeChanged" Tag="Y:None" />
                            <RadioButton Content="Min" GroupName="AlignFaceY" Margin="0,0,8,0" Checked="OnAlignFaceModeChanged" Tag="Y:Minimum" />
                            <RadioButton Content="Centre" GroupName="AlignFaceY" Margin="0,0,8,0" Checked="OnAlignFaceModeChanged" Tag="Y:Centre" />
                            <RadioButton Content="Max" GroupName="AlignFaceY" Checked="OnAlignFaceModeChanged" Tag="Y:Maximum" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Z" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="Leave" GroupName="AlignFaceZ" Margin="0,0,8,0" IsChecked="True" Checked="OnAlignFaceModeChanged" Tag="Z:None" />
                            <RadioButton Content="Min" GroupName="AlignFaceZ" Margin="0,0,8,0" Checked="OnAlignFaceModeChanged" Tag="Z:Minimum" />
                            <RadioButton Content="Centre" GroupName="AlignFaceZ" Margin="0,0,8,0" Checked="OnAlignFaceModeChanged" Tag="Z:Centre" />
                            <RadioButton Content="Max" GroupName="AlignFaceZ" Checked="OnAlignFaceModeChanged" Tag="Z:Maximum" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply" Style="{StaticResource PanelButton}" Command="{Binding ApplyAlignFaceCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}" Command="{Binding CancelAlignFaceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sketch panel, shown only while sketching. Shares a row with Measure: the two are
                     never out at once. -->
                <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        AutomationProperties.AutomationId="SketchPanel"
                        Visibility="{Binding IsSketchMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Sketch" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <RadioButton Content="Line" GroupName="SketchTool" Margin="0,0,12,4"
                                         IsChecked="{Binding SketchLine, Mode=TwoWay}"
                                         ToolTip="Straight lines, point after point" />
                            <RadioButton Content="Arc" GroupName="SketchTool" Margin="0,0,12,4"
                                         IsChecked="{Binding SketchArc, Mode=TwoWay}"
                                         ToolTip="On from the last point: click where it ends, then move to bend it and click. Lines and arcs join into one outline." />
                            <RadioButton Content="Curve" GroupName="SketchTool" Margin="0,0,12,4"
                                         IsChecked="{Binding SketchCurve, Mode=TwoWay}"
                                         ToolTip="A smooth closed curve through the points clicked" />
                            <RadioButton Content="Freehand" GroupName="SketchTool" Margin="0,0,12,4"
                                         IsChecked="{Binding SketchFreehand, Mode=TwoWay}"
                                         ToolTip="Press and drag round the shape; let go to close it" />
                            <RadioButton Content="Rectangle" GroupName="SketchTool" Margin="0,0,12,4"
                                         IsChecked="{Binding SketchRectangle, Mode=TwoWay}" />
                            <RadioButton Content="Circle" GroupName="SketchTool" Margin="0,0,12,4"
                                         IsChecked="{Binding SketchCircle, Mode=TwoWay}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Snap" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="Points land on a grid this fine" />
                            <ComboBox Width="80" SelectedIndex="{Binding SketchSnapIndex, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="SketchSnap">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="0.5 mm" />
                                <ComboBoxItem Content="1 mm" />
                                <ComboBoxItem Content="5 mm" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{Binding SketchMessage}" TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SketchReadout}" TextWrapping="Wrap" Foreground="#FF5A5F66" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Close" Style="{StaticResource PanelButton}" Command="{Binding SketchCloseCommand}"
                                    ToolTip="Close the line being drawn into an outline (Enter, or a right-click on the plate)" />
                            <Button Content="Undo" Style="{StaticResource PanelButton}" Command="{Binding SketchUndoCommand}"
                                    ToolTip="Take back the last point, or the last outline (Backspace)" />
                            <Button Content="Clear" Style="{StaticResource PanelButton}" Command="{Binding SketchClearCommand}"
                                    ToolTip="Throw the sketch away" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Load SVG" Style="{StaticResource PanelButton}" Command="{Binding SketchLoadDrawingCommand}"
                                    AutomationProperties.AutomationId="SketchLoadSvg"
                                    ToolTip="Bring the filled shapes of an SVG drawing into the sketch, as wide as set here, its lower left corner on the origin - to extrude, revolve, or draw beside. Turn text into paths in the drawing program first." />
                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}" Margin="4,0,6,0"
                                       ToolTip="How wide the drawing comes in: a drawing's own units are not worth trusting" />
                            <TextBox Width="52" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="SketchDrawingWidth"
                                     Text="{Binding SketchDrawingWidth, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Extrude" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Height" Style="{StaticResource FieldLabel}" Width="62" />
                            <TextBox Width="60" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="SketchHeight"
                                     Text="{Binding SketchHeight, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Extrude" Style="{StaticResource PanelButton}" Command="{Binding SketchExtrudeCommand}" />
                        </StackPanel>

                        <TextBlock Text="Revolve" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Draw half the outline, to one side of the axis: it is turned round the axis to make the rest."
                                   TextWrapping="Wrap" Foreground="#FF7A8088" Margin="0,0,0,4" />
                        <WrapPanel Margin="0,0,0,4">
                            <RadioButton Content="About Y (stands up)" GroupName="RevolveAxis" Margin="0,0,12,0"
                                         IsChecked="{Binding RevolveAboutY, Mode=TwoWay}"
                                         ToolTip="Turned about the green Y axis, the sketch's Y becomes the height: draw to the right of the axis" />
                            <RadioButton Content="About X (lies along X)" GroupName="RevolveAxis"
                                         IsChecked="{Binding RevolveAboutX, Mode=TwoWay}"
                                         ToolTip="Turned about the red X axis: draw on the far side of the axis" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Angle" Style="{StaticResource FieldLabel}" Width="62" ToolTip="360 for all the way round" />
                            <TextBox Width="60" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="RevolveAngle"
                                     Text="{Binding RevolveAngle, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="degrees" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Segments" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="How many flat sides make a full turn: more is smoother, and heavier to cut into" />
                            <TextBox Width="60" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="RevolveSegments"
                                     Text="{Binding RevolveSegments, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <Button Content="Revolve" Style="{StaticResource PanelButton}" HorizontalAlignment="Left"
                                Command="{Binding SketchRevolveCommand}" Margin="0,0,0,12" />

                        <Button Content="Done" Style="{StaticResource PanelButton}" HorizontalAlignment="Left"
                                Command="{Binding DoneSketchCommand}"
                                ToolTip="Leave the sketch. It is kept, to extrude or revolve again later." />
                    </StackPanel>
                </Border>

                <!-- Measure panel, shown only while measuring -->
                <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsMeasureMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Measure" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding MeasureSummary}" TextWrapping="Wrap"
                                   Foreground="#FF3A4550" Margin="0,0,0,8" />
                        <CheckBox Content="Snap to corners and edges" Margin="0,0,0,8"
                                  IsChecked="{Binding MeasureSnap, Mode=TwoWay}"
                                  ToolTip="Pull each click onto the nearest corner or edge midpoint, so the reading is exact" />
                        <Button Content="Done" Style="{StaticResource PanelButton}"
                                Command="{Binding CancelMeasureCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Engrave panel, shown only while a face is being picked -->
                <Border Grid.Row="4" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsEngraveMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Engrave a pattern" FontWeight="SemiBold" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding EngraveSummary}" TextWrapping="Wrap"
                                   Foreground="#FF3A4550" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}" Width="76" />
                            <ComboBox Width="120" ItemsSource="{Binding EngravePatterns}"
                                      DisplayMemberPath="Label" SelectedValuePath="Kind"
                                      SelectedValue="{Binding EngravePattern}"
                                      AutomationProperties.AutomationId="EngravePattern" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding EngraveDirectionApplies, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Runs" Style="{StaticResource FieldLabel}" Width="76" />
                            <ComboBox Width="120" ItemsSource="{Binding EngraveDirections}"
                                      SelectedItem="{Binding EngraveDirection}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                    Visibility="{Binding EngraveIsGrooves, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Size" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="Brick length, board width, or the gap between stripes" />
                            <TextBox AutomationProperties.AutomationId="EngraveSize" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EngraveSize, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                    Visibility="{Binding EngraveIsGrooves, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Line width" Style="{StaticResource FieldLabel}" Width="76" />
                            <TextBox AutomationProperties.AutomationId="EngraveWidth" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EngraveGrooveWidth, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding EngraveDepthApplies, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EngraveDepthLabel}" Style="{StaticResource FieldLabel}" Width="76" />
                            <TextBox AutomationProperties.AutomationId="EngraveDepth" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EngraveDepth, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Studs and brick undersides: the grid is fixed, only the fit is the printer's -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding EngraveIsStuds, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Fit" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="How much fatter than standard to make the studs, or the tubes and walls that grip them - in mm across. Positive grips harder, negative looser. Studs change by the whole Fit; tubes, rods and walls by half of it on each surface, so the space for a stud shrinks by the whole Fit too. Printed studs come out a little fat, so -0.1 suits PLA on a tuned printer and about -0.15 PETG. Print the Fit test from the Insert tab to find yours." />
                            <TextBox AutomationProperties.AutomationId="EngraveStudFit" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EngraveStudFit, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Offsets: sliding the pattern is how a corner is made to line up -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Shift across" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="Slides the pattern sideways. Use it to line the joints up with the next wall - arrow keys and the wheel nudge it." />
                            <TextBox AutomationProperties.AutomationId="EngraveShiftAcross" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EngraveOffsetU, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Shift along" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="Slides the pattern the other way, for lining courses up with a neighbouring face." />
                            <TextBox AutomationProperties.AutomationId="EngraveShiftAlong" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EngraveOffsetV, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                    Visibility="{Binding EngraveAspectApplies, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="How many times longer each piece is than it is tall. Each pattern starts at its own: brick 3, roof tile 1.5, wall tile 1, plank 8." />
                            <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="EngraveAspect"
                                     Text="{Binding EngraveAspect, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text=": 1" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Raised pattern" Margin="0,6,0,10"
                                  Visibility="{Binding EngraveIsGrooves, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.AutomationId="EngraveRaised"
                                  IsChecked="{Binding EngraveRaised, Mode=TwoWay}"
                                  ToolTip="Stand the bricks off the face rather than cutting the joints in. Separate pieces rather than one web of joints, which the boolean finds easier - and a raised line prints where a groove the same size is missed." />

                        <!-- Printing advice: what these settings will actually do on a printer -->
                        <Border Background="#FFFFF6E8" BorderBrush="#FFE8C88A" BorderThickness="1"
                                CornerRadius="3" Padding="7,5" Margin="0,0,0,8"
                                Visibility="{Binding HasEngraveAdvice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EngraveAdvice}" TextWrapping="Wrap" Foreground="#FF6B4E12" />
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Engrave" Style="{StaticResource PanelButton}"
                                    Command="{Binding ApplyEngraveCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}"
                                    Command="{Binding CancelEngraveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Lettering panel, shown only while a face is being lettered -->
                <Border Grid.Row="5" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsEmbossMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Emboss" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding EmbossSummary}" TextWrapping="Wrap"
                                   Foreground="#FF3A4550" Margin="0,0,0,8" />

                        <!-- What will be stamped. A file name says nothing about whether the right
                             thing came out of a drawing - holes especially - and a font name says
                             nothing about whether it has the letters typed. -->
                        <Border Background="White" BorderBrush="#FFB8D2F0" BorderThickness="1"
                                CornerRadius="3" Padding="6" Margin="0,0,0,6">
                            <StackPanel>
                                <Path MaxHeight="72" Stretch="Uniform" Fill="#FF2C3037"
                                      HorizontalAlignment="Center"
                                      Data="{Binding DrawingShapes, Converter={StaticResource OutlinesToGeometry}}" />
                                <TextBlock Text="{Binding SvgName}" Margin="0,6,0,0" FontSize="11"
                                           Visibility="{Binding HasDrawing, Converter={StaticResource BoolToVisibility}}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="#FF6B7480" ToolTip="{Binding SvgName}" />
                            </StackPanel>
                        </Border>

                        <TextBox AutomationProperties.AutomationId="EmbossText" Text="{Binding EmbossText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,3" Margin="0,0,0,6" FontSize="14"
                                 Visibility="{Binding UsesText, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding UsesText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Font" Style="{StaticResource FieldLabel}" Width="62" />
                            <ComboBox Width="180" ItemsSource="{Binding EmbossFonts}"
                                      SelectedItem="{Binding EmbossFont, Mode=TwoWay}">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <!-- In the list, each name is followed by the lettering being typed, in that
                                     font - the only way to see whether a font has the letters before
                                     picking it. The name stays in the ordinary face, or a symbol font would
                                     hide its own name. The closed box shows the name alone: there is no
                                     ComboBoxItem round it there, so the trigger below never fires. -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FontName" Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="FontSample" Visibility="Collapsed" Margin="12,0,0,0"
                                                       FontFamily="{Binding}" FontSize="16" MaxWidth="240"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Text="{Binding DataContext.EmbossText, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=False}"
                                                         Value="True">
                                                <Setter TargetName="FontSample" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="FontName" Property="Width" Value="190" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding UsesText, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Bold" IsChecked="{Binding EmbossBold, Mode=TwoWay}" Margin="0,0,16,0" />
                            <CheckBox Content="Italic" IsChecked="{Binding EmbossItalic, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding UsesText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Spacing" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="Extra room after every letter. Negative draws the letters closer." />
                            <TextBox AutomationProperties.AutomationId="EmbossSpacing" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossSpacing, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- A drawing instead of typed letters. It becomes outlines the moment it
                             is read, so everything below applies to it unchanged. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Drawing..." Style="{StaticResource PanelButton}"
                                    Command="{Binding LoadDrawingCommand}"
                                    ToolTip="Stamp the filled shapes of an SVG file instead of typing. Turn text into paths in the drawing program first." />
                            <Button Content="Use text" Style="{StaticResource PanelButton}"
                                    Command="{Binding ClearDrawingCommand}"
                                    Visibility="{Binding HasDrawing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Height" Style="{StaticResource FieldLabel}" Width="62" />
                            <TextBox AutomationProperties.AutomationId="EmbossHeight" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossHeight, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="How deep it is cut, or how far it stands proud" />
                            <TextBox AutomationProperties.AutomationId="EmbossDepth" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossDepth, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Bevel" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="Slopes the walls, so raised lettering has no step to bridge and cut lettering is not a slot one line wide. Zero leaves them upright." />
                            <TextBox AutomationProperties.AutomationId="EmbossBevel" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossBevel, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Wrap" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="Flat on the face, or bent round the object as a barrel or a ball" />
                            <ComboBox Width="130" ItemsSource="{Binding EmbossProjections}"
                                      SelectedItem="{Binding EmbossProjection, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Where it sits. The scene handles drive the same three numbers, so a
                             drag can be tidied up here and a number can be nudged with the arrows. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Across" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="How far from the middle, along the lettering" />
                            <TextBox AutomationProperties.AutomationId="EmbossAcross" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossAcross, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Up" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="How far from the middle, across the lettering" />
                            <TextBox AutomationProperties.AutomationId="EmbossUp" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossUp, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Turn" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="Which way up the lettering runs" />
                            <TextBox AutomationProperties.AutomationId="EmbossAngle" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossAngle, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="deg" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Repeating the stamp. The distance is between the edges of one copy
                             and the next, so it means the same thing whatever is being stamped. -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="How many copies of the stamp go across the face and how many rows of them go up it. 1 x 1 is a single stamp. Ignored while Fill the face is on, which works the numbers out for itself." />
                            <TextBox AutomationProperties.AutomationId="EmbossColumns" Width="44" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossColumns, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="x" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="4,0" />
                            <TextBox AutomationProperties.AutomationId="EmbossRows" Width="44" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossRows, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Distance" Style="{StaticResource FieldLabel}" Width="62"
                                       ToolTip="The blank left between one copy and the next, edge to edge." />
                            <TextBox AutomationProperties.AutomationId="EmbossGap" Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     Text="{Binding EmbossGap, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Fill the face" IsChecked="{Binding EmbossFill, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="EmbossFill" Margin="0,4,0,8"
                                  ToolTip="Covers the whole face with as many as fit at that distance, instead of the numbers above. Wrapped round a part, it goes the whole way round and the distance takes up the difference so there is no seam." />

                        <CheckBox Content="Raised instead of cut" IsChecked="{Binding EmbossRaised, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="EmbossRaised"
                                  Margin="0,0,0,6"
                                  ToolTip="Stand the lettering off the face rather than sinking it in" />

                        <CheckBox Content="Keep as its own part" IsChecked="{Binding EmbossSeparate, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="EmbossSeparate"
                                  Margin="0,0,0,8"
                                  ToolTip="For printing the lettering in another filament. Cut, the object gets the recess and the letters come back as the plug that fills it flush; raised, they stand on it. The letters go onto the next filament up, and the pair export to a 3MF that says so." />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply" Style="{StaticResource PanelButton}"
                                    Command="{Binding ApplyEmbossCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}"
                                    Command="{Binding CancelEmbossCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Colour. Bound to the view model rather than to Selected, because painting
                     applies to the whole selection and Selected is null once more than one
                     object is picked. -->
                <!-- Connect objects panel: pins through the face two parts rest against each other on. -->
                <Border Grid.Row="6" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsConnectMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Connect objects" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ConnectSummary}" TextWrapping="Wrap"
                                   Foreground="#FF3A4550" Margin="0,0,0,8" />
                        <StackPanel Margin="0,2,0,8">
                            <TextBlock Text="Connectors" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton Content="Separate pins" GroupName="ConnectStyle" Margin="0,0,10,0"
                                             IsChecked="{Binding ConnectorsArePins, Mode=TwoWay}"
                                             ToolTip="Holes in both halves, and the pins made as parts of their own - printed lying down, so they are strong along their length. A broken pin is a reprint, not a lost half." />
                                <RadioButton Content="Pegs on one half" GroupName="ConnectStyle" Margin="0,0,10,0"
                                             IsChecked="{Binding ConnectorsArePegs, Mode=TwoWay}"
                                             ToolTip="Pegs standing out of one half, sockets in the other. Nothing loose to lose, but pegs printed standing up are weak across their layers." />
                                <RadioButton Content="Brick studs" GroupName="ConnectStyle"
                                             IsChecked="{Binding ConnectorsAreBricks, Mode=TwoWay}"
                                             ToolTip="Brick studs on the lower half and a shallow brick underside in the upper, on the 8 mm grid. The halves hold by grip, and each takes real bricks along the join. The grid repeats, so line the edges up by eye." />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                        Visibility="{Binding ConnectorsArePegs, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Peg shape" Style="{StaticResource FieldLabel}" Width="76" />
                                <RadioButton Content="Round" GroupName="ConnectPegShape" Margin="0,0,10,0" VerticalAlignment="Center"
                                             IsChecked="{Binding ConnectorPegRound, Mode=TwoWay}"
                                             ToolTip="Round pegs in round sockets. Use two or more: one round peg lets the halves turn on it." />
                                <RadioButton Content="Square" GroupName="ConnectPegShape" VerticalAlignment="Center"
                                             IsChecked="{Binding ConnectorPegSquare, Mode=TwoWay}"
                                             ToolTip="Square pegs in square sockets, the size box giving the side. A square peg cannot turn, so even one lines the halves up. Its corners reach further than a round peg, so it keeps a little further from the edge." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                        Visibility="{Binding ConnectorsAreBricks, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Fit" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="How much fatter than standard the studs, and the tubes and walls that grip them, are made - in mm across, on both halves. The two halves add up: at -0.1 each there is about 0.2 mm of play in all. -0.1 suits PLA on a tuned printer, about -0.15 PETG." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         Text="{Binding ConnectorBrickFit, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF7A8088" Margin="0,0,0,6"
                                       Visibility="{Binding ConnectorsAreBricks, Converter={StaticResource BoolToVisibility}}"
                                       Text="Use Fit test on the Insert tab to find your Fit: print the set twice and try each plate on its twin - that is how these two halves will meet." />
                            <StackPanel Visibility="{Binding ConnectorsAreRound, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="Square to cut" GroupName="ConnectDirection" Margin="0,0,8,0"
                                             IsChecked="{Binding ConnectorsPerpendicular, Mode=TwoWay}"
                                             ToolTip="Square to the cut face, whichever way the plane is turned." />
                                <RadioButton Content="Vertical" GroupName="ConnectDirection" Margin="0,0,8,0"
                                             IsChecked="{Binding ConnectorsVertical, Mode=TwoWay}"
                                             ToolTip="Straight up and down, so the top half of a tilted cut still lifts straight off. Not on a vertical cut, which they would run along." />
                                <RadioButton Content="Horizontal" GroupName="ConnectDirection"
                                             IsChecked="{Binding ConnectorsHorizontal, Mode=TwoWay}"
                                             ToolTip="Level, towards the cut, so a half on a leaning cut slides off sideways. Not on a level cut, which they would run along." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="How many" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="At most this many. They go only where there is solid round them, as far apart as they will fit." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectCount"
                                         Text="{Binding ConnectorCount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding ConnectorSizeLabel}" Style="{StaticResource FieldLabel}" Width="76" />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectDiameter"
                                         Text="{Binding ConnectorDiameter, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="How far a connector goes into each half." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectDepth"
                                         Text="{Binding ConnectorDepth, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Clearance" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="Per side, as for Subtract: a 5 mm pin with 0.2 goes into a 5.4 mm hole." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectClearance"
                                         Text="{Binding ConnectorClearance, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="From edge" Style="{StaticResource FieldLabel}" Width="76"
                                           ToolTip="Material left between a hole and the outside of the part. Pins go out towards the edges until this much is left - further apart registers better, but a thin wall beside a hole can split." />
                                <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                         AutomationProperties.AutomationId="ConnectEdgeDistance"
                                         Text="{Binding ConnectorEdgeDistance, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Both parts are kept, each as itself." Foreground="#FF7A8088" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Connect" Style="{StaticResource PanelButton}"
                                    AutomationProperties.AutomationId="ConnectApply"
                                    Command="{Binding ApplyConnectCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}"
                                    Command="{Binding CancelConnectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Extrude down panel. The plane on the model shows where the cut goes. -->
                <Border Grid.Row="6" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsExtrudeMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Extrude down" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Foreground="#FF3A4550" Margin="0,0,0,8"
                                   Text="Everything below the plane is replaced by straight walls down to a flat base on the plate, following the model's outline at that height. Drag the arrows to move the plane, or type the height." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Height" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="Where the model is cut. Set it above any ragged part of the bottom, so the walls start from a clean section." />
                            <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="ExtrudeHeight"
                                     Text="{Binding ExtrudeHeight, StringFormat=0.##, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            <TextBlock Text="{Binding UnitLabel}" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply" Style="{StaticResource PanelButton}"
                                    AutomationProperties.AutomationId="ExtrudeApply"
                                    Command="{Binding ApplyExtrudeCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}"
                                    Command="{Binding CancelExtrudeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Subtract panel. A boolean cannot be taken back except by undo, and the two
                     settings here change what it produces, so it asks before it cuts. -->
                <Border Grid.Row="6" Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsSubtractMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Subtract" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SubtractSummary}" TextWrapping="Wrap"
                                   Foreground="#FF3A4550" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Tolerance" Style="{StaticResource FieldLabel}" Width="76"
                                       ToolTip="How much bigger than the cutter the opening comes out, on every side. A 3 mm pin subtracted with 0.2 leaves a 3.4 mm bore." />
                            <TextBox Width="64" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="SubtractTolerance"
                                     ToolTip="Millimetres per side. Exact on a cube, a cylinder or a sphere; on anything else it asks first, since a sloped or off-axis face can come out with less than the number typed. 0 subtracts exactly as before."
                                     Text="{Binding SubtractTolerance, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>

                        <CheckBox Content="Keep what is taken away" Margin="0,6,0,10"
                                  AutomationProperties.AutomationId="SubtractKeepsCutter"
                                  IsChecked="{Binding SubtractKeepsCutter, Mode=TwoWay}"
                                  ToolTip="Leave the cutter on the plate afterwards. A pin that bored its own hole is usually a part in its own right, and modelling it twice is how the two stop matching." />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply" Style="{StaticResource PanelButton}"
                                    AutomationProperties.AutomationId="SubtractApply"
                                    Command="{Binding ApplySubtractCommand}" />
                            <Button Content="Cancel" Style="{StaticResource PanelButton}"
                                    AutomationProperties.AutomationId="SubtractCancel"
                                    Command="{Binding CancelSubtractCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="8">
                <!-- Overhangs: which faces will need support, and how they are marked. Not a tool
                     either - Close here is the same switch as the ribbon's own toggle. -->
                <Border Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        AutomationProperties.AutomationId="OverhangsPanel"
                        Visibility="{Binding ShowOverhangs, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PanelButton}"
                                    Command="{Binding CloseOverhangsPanelCommand}" />
                            <TextBlock Text="Overhangs" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Angle" Style="{StaticResource FieldLabel}" Width="50"
                                       ToolTip="How far from upright a face may lean before it counts. 45 degrees suits most printers; a well-cooled one manages 50 or more." />
                            <ComboBox Width="70" ItemsSource="{Binding OverhangAngles}" SelectedItem="{Binding OverhangAngle, Mode=TwoWay}"
                                      ItemStringFormat="{}{0:0}°" AutomationProperties.AutomationId="OverhangAngle" />
                        </StackPanel>

                        <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding OverhangSwatches}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SwatchButton}"
                                            Background="{Binding Colour, Converter={StaticResource ColourToBrush}}"
                                            ToolTip="{Binding Name}"
                                            CommandParameter="{Binding Colour}"
                                            Command="{Binding DataContext.SetOverhangColourCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Custom..." Command="{Binding PickOverhangColourCommand}"
                                HorizontalAlignment="Left" Padding="10,3" ToolTip="Pick any colour" />
                    </StackPanel>
                </Border>

                <!-- Grid settings: the printable area, and what is drawn on the plate. Not a tool - it
                     stands nothing down and can stay open while working. -->
                <Border Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsGridPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Grid" FontWeight="SemiBold" Margin="0,0,0,6" />

                        <TextBlock Text="Printable area" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"
                                   ToolTip="The build volume in millimetres. A guide, not a limit: Fit and Distribute use it, and nothing else is held to it." />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <TextBlock Text="W" Style="{StaticResource GizmoLabelX}" Margin="0,0,3,0" />
                            <TextBox Width="48" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="PlateWidth"
                                     Text="{Binding PlateWidth, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="D" Style="{StaticResource GizmoLabelY}" Margin="2,0,3,0" />
                            <TextBox Width="48" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="PlateDepth"
                                     Text="{Binding PlateDepth, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="H" Style="{StaticResource GizmoLabelZ}" Margin="2,0,3,0" />
                            <TextBox Width="48" Style="{StaticResource NumberBox}" Tag="number"
                                     AutomationProperties.AutomationId="PlateHeight"
                                     Text="{Binding PlateHeight, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="mm" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Show axes" IsChecked="{Binding ShowAxes, Mode=TwoWay}" Margin="0,0,0,4"
                                  ToolTip="The X and Y lines across the plate, paler on the negative side" />
                        <CheckBox Content="Show Z axis" IsChecked="{Binding ShowZAxis, Mode=TwoWay}" Margin="0,0,0,4"
                                  ToolTip="An upright line as tall as the printable height" />
                        <CheckBox Content="Show grid labels" IsChecked="{Binding ShowGridLabels, Mode=TwoWay}" Margin="0,0,0,4"
                                  ToolTip="Distances along the positive X and Y axes, in the current units" />
                        <CheckBox Content="Shadows" IsChecked="{Binding ShowShadows, Mode=TwoWay}" Margin="0,0,0,4"
                                  ToolTip="Objects cast a shadow onto the plate and each other. Costs a render pass, so it is worth turning off on a slower machine." />
                        <CheckBox Content="Reflections" IsChecked="{Binding ShowReflections, Mode=TwoWay}" Margin="0,0,0,8"
                                  ToolTip="The plate reflects what stands on it, the way a glossy print bed does. Costs a render pass, so it is worth turning off on a slower machine." />

                        <Button Content="Close" Style="{StaticResource PanelButton}" HorizontalAlignment="Left"
                                Command="{Binding CloseGridPanelCommand}" />
                    </StackPanel>
                </Border>

                <!-- Keyboard and mouse: listed from View/Shortcuts, which is what binds the keys. -->
                <Border Margin="0,10,0,0" Padding="8" Background="#FFEFF5FF"
                        BorderBrush="#FFB8D2F0" BorderThickness="1" CornerRadius="3"
                        AutomationProperties.AutomationId="ShortcutsPanel"
                        Visibility="{Binding IsShortcutsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PanelButton}"
                                    Command="{Binding CloseShortcutsPanelCommand}" />
                            <TextBlock Text="Keyboard and mouse" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding ShortcutGroups}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF3A4550" Margin="0,0,0,3" />
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4,0"
                                                                    CornerRadius="2" Background="White" BorderBrush="#FFC8CCD2" BorderThickness="1">
                                                                <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="11" Foreground="#FF2C3037" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding What}" TextWrapping="Wrap"
                                                                       Foreground="#FF3A3F45" Margin="6,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </StackPanel>

                <!-- The selection: its name, then how it looks and where it is, under Properties so
                     they fold away when the objects list wants the room. Colour is for any
                     selection; the numbers only for one object. -->
                <ScrollViewer Grid.Row="9" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                              Visibility="{Binding PropertiesVisible, Converter={StaticResource BoolToVisibility}}"
                              IsEnabled="{Binding NothingInHand}">
                    <StackPanel Visibility="{Binding HasAnySelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding Selected}" Style="{StaticResource OneObjectOnly}">
                            <TextBlock Text="Name" Style="{StaticResource SectionHeader}" />
                            <TextBox AutomationProperties.AutomationId="ObjectName" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Padding="4,3" />
                        </StackPanel>

                        <Expander Margin="0,10,0,0" IsExpanded="{Binding ShowProperties, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="PropertiesSection">
                            <Expander.Header>
                                <TextBlock Text="Properties" FontWeight="SemiBold" Foreground="#FF33373D" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Colour" Style="{StaticResource SectionHeader}" Margin="0,6,0,4" />
                                <ItemsControl ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}"
                                                    Background="{Binding Colour, Converter={StaticResource ColourToBrush}}"
                                                    ToolTip="{Binding Name}"
                                                    CommandParameter="{Binding Colour}"
                                                    Command="{Binding DataContext.SetColourCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Custom..." Command="{Binding PickColourCommand}"
                                        HorizontalAlignment="Left" Padding="10,3" Margin="1,6,0,0"
                                        ToolTip="Pick any colour" />

                                <!-- Which spool prints it. Not the colour: the colour is how the
                                     model is looked at while it is being made. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Filament" Style="{StaticResource FieldLabel}" Width="62"
                                               ToolTip="Which filament prints the selection on a printer that has more than one - an AMS slot, an MMU tool. 1 unless you say otherwise. Carried into an exported 3MF; STL and OBJ have nowhere to put it." />
                                    <TextBox AutomationProperties.AutomationId="ObjectFilament" Width="48"
                                             Style="{StaticResource NumberBox}" Tag="number"
                                             Text="{Binding ObjectFilament, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="of 16" Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel DataContext="{Binding Selected}" Style="{StaticResource OneObjectOnly}">
                                    <TextBlock Text="{Binding DataContext.UnitLabel, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Position ({0})'}" Style="{StaticResource SectionHeader}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="PositionX" Grid.Column="1" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding DataContext.ObjectPositionX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="PositionY" Grid.Column="3" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding DataContext.ObjectPositionY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="4" Text="Z" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="PositionZ" Grid.Column="5" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding DataContext.ObjectPositionZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <TextBlock Text="{Binding DataContext.UnitLabel, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Size ({0})'}" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Text="{Binding RealSize}" Foreground="#FF6B7480" FontSize="11"
                                               Margin="0,0,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- W, D, H rather than X, Y, Z: these are dimensions, not
                                             coordinates, and for a single object they are its own extents -
                                             SizeX is the local size, so it does not change when the part is
                                             turned. In a Z-up scene the axes read across as width, depth,
                                             height, so the letters keep the same order as the boxes beside
                                             them and as the gizmo handles. -->
                                        <TextBlock Text="W" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Width - along X" />
                                        <TextBox AutomationProperties.AutomationId="SizeX" Grid.Column="1" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding DataContext.ObjectSizeX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="2" Text="D" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Depth - along Y" />
                                        <TextBox AutomationProperties.AutomationId="SizeY" Grid.Column="3" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding DataContext.ObjectSizeY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="4" Text="H" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Height - along Z" />
                                        <TextBox AutomationProperties.AutomationId="SizeZ" Grid.Column="5" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding DataContext.ObjectSizeZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <TextBlock Text="Rotation (degrees)" Style="{StaticResource SectionHeader}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="RotationX" Grid.Column="1" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding RotationX, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="RotationY" Grid.Column="3" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding RotationY, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="4" Text="Z" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="RotationZ" Grid.Column="5" Style="{StaticResource NumberBox}" Tag="transform"
                                                 Text="{Binding RotationZ, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <!-- Only for a pivot somebody chose. The pivot is the
                                         object's origin, so in its own coordinates it is nought
                                         and saying so would tell nobody anything; what is worth
                                         reading, and typing, is where in the part it sits. -->
                                    <StackPanel Visibility="{Binding DataContext.ShowPivotFields, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding DataContext.UnitLabel, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Pivot, from the middle ({0})'}" Style="{StaticResource SectionHeader}"
                                                   ToolTip="Where the object turns and is measured about, as an offset from the middle of its own box. 0, 0, 0 is the middle. Set it by clicking a point with Set pivot on the Edit tab, or type it here." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.AutomationId="PivotX" Grid.Column="1" Style="{StaticResource NumberBox}" Tag="transform"
                                                     Text="{Binding DataContext.ObjectPivotX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.AutomationId="PivotY" Grid.Column="3" Style="{StaticResource NumberBox}" Tag="transform"
                                                     Text="{Binding DataContext.ObjectPivotY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Grid.Column="4" Text="Z" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.AutomationId="PivotZ" Grid.Column="5" Style="{StaticResource NumberBox}" Tag="transform"
                                                     Text="{Binding DataContext.ObjectPivotZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- A tool's settings: Custom, Stair, Repeat, Smooth, Round, Simplify, Hollow, Rebuild,
                     Mould, Twist, Taper and Bend. In the tall last row, so a long panel scrolls rather
                     than running off the bottom of the window. See View/ToolPanel. -->
                <ScrollViewer Grid.Row="9" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                              Visibility="{Binding HasOpenPanel, Converter={StaticResource BoolToVisibility}}">
                    <Border Padding="8" Background="#FFEFF5FF" BorderBrush="#FFB8D2F0"
                            BorderThickness="1" CornerRadius="3" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding OpenPanel.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <!-- Still being proved out. See ToolPanel.IsBeta. -->
                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8"
                                        Background="#FFF3C969" BorderBrush="#FFC79A1E" BorderThickness="1"
                                        Visibility="{Binding OpenPanel.IsBeta, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="This tool is new and still being proved out. It works, and it is worth checking what it gives you before you print it.">
                                    <TextBlock Text="beta" FontSize="10" FontWeight="SemiBold" Foreground="#FF5C4708" />
                                </Border>
                            </StackPanel>
                            <ContentControl Content="{Binding OpenPanel}" Focusable="False" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Viewport -->
        <Grid>
            <hx:Viewport3DX x:Name="View"
                            BackgroundColor="#FFB8BCC2"
                            MSAA="Four"
                            FXAALevel="Low"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            UseDefaultGestures="True"
                            ZoomExtentsWhenLoaded="False"
                            IsShadowMappingEnabled="{Binding ShowShadows}">
                <!-- The key follows the camera - see MainWindow.LightTheView. Both lights used
                     to be fixed in the world and both pointed downwards, so an upright wall got
                     almost no light at all and turning round to the far side of a model left you
                     looking at the unlit half of it. -->
                <hx:AmbientLight3D Color="#FF4E5259" />
                <hx:DirectionalLight3D x:Name="KeyLight" Direction="-0.5,-0.8,-1.0" Color="#FFB4B4B4" />
                <hx:DirectionalLight3D x:Name="FillLight" Direction="0.55,0.35,0.75" Color="#FF4E5258" />

                <!-- Only costs anything while IsShadowMappingEnabled is on - see ShowShadows. -->
                <hx:ShadowMap3D Resolution="2048,2048" />

                <hx:GroupModel3D x:Name="PlateGroup" />
                <hx:GroupModel3D x:Name="ContentGroup" />
                <hx:GroupModel3D x:Name="OverlayGroup" />
            </hx:Viewport3DX>

            <!-- Manipulator handles. No background, so clicks that miss fall through to the camera. -->
            <Canvas x:Name="GizmoLayer" ClipToBounds="True" Background="{x:Null}" />

            <!-- Handles for the split plane, on their own layer so the two never interleave. -->
            <Canvas x:Name="SplitGizmoLayer" ClipToBounds="True" Background="{x:Null}" />

            <!-- Handles for placing lettering or a pattern on a face. Its own layer for the same
                 reason as the split one: the two never interleave. -->
            <Canvas x:Name="PlacementGizmoLayer" ClipToBounds="True" Background="{x:Null}" />

            <!-- The measuring tape, drawn over everything so it is never hidden by the model. -->
            <!-- Hit-testable so the two ends can be taken hold of. The canvas has no background,
                 so only the markers themselves catch the mouse; everywhere else the click falls
                 through to the viewport as before. -->
            <Canvas x:Name="MeasureLayer" ClipToBounds="True" Background="{x:Null}" />

            <!-- Repair banner, as in 3D Builder: the model says it is broken and offers to mend it -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,18,18"
                    Background="#FFFFFFFF" BorderBrush="#FFD64545" BorderThickness="4,1,1,1"
                    CornerRadius="2" Padding="0"
                    Visibility="{Binding HasDamagedObjects, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.28" />
                </Border.Effect>
                <Button Command="{Binding RepairCommand}" Padding="14,10" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Fill holes, drop slivers and turn faces the right way round">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRepair}" Stroke="#FF5A5F66" StrokeThickness="1.4"
                              Fill="Transparent" Width="24" Height="24" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="One or more objects are invalidly defined." Foreground="#FF33383F" />
                            <TextBlock Text="Click here to repair." Foreground="#FF5A5F66" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Border>

            <!-- The history has had to drop its oldest steps to stay inside its budget, so undo
                 will no longer reach all the way back. Saving a version is the thing that still
                 gets you there, so the notice offers to do it rather than only warning. -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="18,0,0,18"
                    Background="#FFFFFFFF" BorderBrush="#FFC98A2E" BorderThickness="4,1,1,1"
                    CornerRadius="2" Padding="0"
                    Visibility="{Binding HistoryTrimmed, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.28" />
                </Border.Effect>
                <Button Command="{Binding SaveVersionCommand}" Padding="14,10" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        AutomationProperties.Name="Save a version"
                        ToolTip="Keeps this state inside the project file under a name, so you can come back to it however far you carry on.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconVersions}" Stroke="#FF5A5F66" StrokeThickness="1.4"
                              Fill="Transparent" Width="24" Height="24" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Undo can no longer go all the way back." Foreground="#FF33383F" />
                            <TextBlock Text="Click here to save a version you can return to." Foreground="#FF5A5F66" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Border>

            <!-- The split plane's own bar, in the same place and shape as the manipulator's.
                 The two are never up together: the manipulator stands down while a tool is
                 running, which is also why the tilt snap has to be offered again here. -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,18" Padding="6,4" CornerRadius="6"
                    Background="#F2FFFFFF" BorderBrush="#FFC8CCD2" BorderThickness="1"
                    Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ModeButton}" ToolTip="Slide the plane along its own facing"
                                  AutomationProperties.Name="Move the plane"
                                  IsChecked="{Binding SplitMoveMode, Mode=TwoWay}">
                        <Path Data="M10,0 L13,3 L11,3 L11,9 L17,9 L17,7 L20,10 L17,13 L17,11 L11,11 L11,17 L13,17 L10,20 L7,17 L9,17 L9,11 L3,11 L3,13 L0,10 L3,7 L3,9 L9,9 L9,3 L7,3 Z"
                              Fill="#FF33383F" Stretch="Uniform" Width="16" Height="16" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ModeButton}" ToolTip="Turn the plane"
                                  AutomationProperties.Name="Turn the plane"
                                  IsChecked="{Binding SplitTurnMode, Mode=TwoWay}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M10,3.5 A6.5,6.5 0 1 1 3.5,10"
                                      Stroke="#FF33383F" StrokeThickness="1.9" Fill="{x:Null}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M9.4,0.4 L14.2,3.5 L9.4,6.6 Z" Fill="#FF33383F" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <Rectangle Width="1" Margin="6,3" Fill="#FFD8DBE0" />

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding SplitMoveMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Offset" Style="{StaticResource GizmoLabel}" />
                        <TextBox Style="{StaticResource GizmoBox}" Tag="number"
                                 AutomationProperties.AutomationId="SplitOffset"
                                 ToolTip="How far along its own facing the plane sits, from the middle of the plate"
                                 Text="{Binding SplitOffset, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="mm" Style="{StaticResource GizmoUnit}" />
                    </StackPanel>

                    <!-- Roll, pitch and yaw are turns about X, Y and Z, the same as an object's.
                         The one about the axis the plane lies on is dead rather than missing:
                         turning a plane about its own facing leaves it exactly where it was. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding SplitTurnMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Roll" Style="{StaticResource GizmoLabelX}" />
                        <TextBox Style="{StaticResource GizmoBox}" Tag="number"
                                 AutomationProperties.AutomationId="SplitRoll"
                                 Text="{Binding SplitRoll, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Pitch" Style="{StaticResource GizmoLabelY}" />
                        <TextBox Style="{StaticResource GizmoBox}" Tag="number"
                                 AutomationProperties.AutomationId="SplitPitch"
                                 Text="{Binding SplitPitch, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Yaw" Style="{StaticResource GizmoLabelZ}" />
                        <TextBox Style="{StaticResource GizmoBox}" Tag="number"
                                 AutomationProperties.AutomationId="SplitYaw"
                                 Text="{Binding SplitYaw, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="deg" Style="{StaticResource GizmoUnit}" />
                        <ToggleButton Style="{StaticResource ModeButton}" Margin="4,0,0,0"
                                      ToolTip="Snap the turn to 15 degree steps"
                                      AutomationProperties.Name="Snap the tilt"
                                      IsChecked="{Binding SnapRotation, Mode=TwoWay}">
                            <Path Data="M2,14 L7,14 L7,9 L13,9 L13,4 L18,4"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Floating manipulator bar: mode buttons, then the live values for that mode -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,18" Padding="6,4" CornerRadius="6"
                    Background="#F2FFFFFF" BorderBrush="#FFC8CCD2" BorderThickness="1"
                    Visibility="{Binding ShowManipulatorBar, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ModeButton}" ToolTip="Move (M)"
                                  AutomationProperties.Name="Move"
                                  IsChecked="{Binding IsMoveMode, Mode=TwoWay}">
                        <Path Data="M10,0 L13,3 L11,3 L11,9 L17,9 L17,7 L20,10 L17,13 L17,11 L11,11 L11,17 L13,17 L10,20 L7,17 L9,17 L9,11 L3,11 L3,13 L0,10 L3,7 L3,9 L9,9 L9,3 L7,3 Z"
                              Fill="#FF33383F" Stretch="Uniform" Width="16" Height="16" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ModeButton}" ToolTip="Rotate (R)"
                                  AutomationProperties.Name="Rotate"
                                  IsChecked="{Binding IsRotateMode, Mode=TwoWay}">
                        <!-- Three quarters of a circle with a solid head. The old one drew the
                             arrow as two loose strokes, which read as a stray tick. -->
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M10,3.5 A6.5,6.5 0 1 1 3.5,10"
                                      Stroke="#FF33383F" StrokeThickness="1.9" Fill="{x:Null}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M9.4,0.4 L14.2,3.5 L9.4,6.6 Z" Fill="#FF33383F" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ModeButton}" ToolTip="Resize (S). While dragging a handle: Ctrl flips Keep proportions, Alt flips One way only, Shift snaps the size to whole millimetres."
                                  AutomationProperties.Name="Resize"
                                  Visibility="{Binding ResizeOffered, Converter={StaticResource BoolToVisibility}}"
                                  IsChecked="{Binding IsScaleMode, Mode=TwoWay}">
                        <Path Data="M2,2 L18,2 L18,18 L2,18 Z M2,2 L2,7 M2,2 L7,2 M18,18 L13,18 M18,18 L18,13"
                              Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </ToggleButton>

                    <Rectangle Width="1" Margin="6,3" Fill="#FFD8DBE0" />


                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsMoveMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}"
                                    Visibility="{Binding DataContext.HasOneSelected,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="X" Style="{StaticResource GizmoLabelX}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding DataContext.ObjectPositionX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Y" Style="{StaticResource GizmoLabelY}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding DataContext.ObjectPositionY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Z" Style="{StaticResource GizmoLabelZ}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding DataContext.ObjectPositionZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <!-- Several selected: the middle of the lot. Typing into it carries the
                             whole group there, keeping its shape, rather than piling them up. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasManySelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="X" Style="{StaticResource GizmoLabelX}" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupX, Converter={StaticResource Mixed}, ConverterParameter=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Y" Style="{StaticResource GizmoLabelY}" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupY, Converter={StaticResource Mixed}, ConverterParameter=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Z" Style="{StaticResource GizmoLabelZ}" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupZ, Converter={StaticResource Mixed}, ConverterParameter=0.####, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource GizmoUnit}" />

                        <!-- The same numbers at the scene's scale, and editable: type metres
                             here or millimetres there and each follows the other. Only the
                             millimetres are stored - an STL has no notion of scale. Hidden at
                             1:1, where the two would say the same thing twice. -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                    Visibility="{Binding ScaleApplies, Converter={StaticResource BoolToVisibility}}">
                            <Rectangle Width="1" Margin="2,3,8,3" Fill="#FFD8DBE0" />
                            <TextBlock Text="X" Style="{StaticResource GizmoLabelX}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     AutomationProperties.AutomationId="RealPosX"
                                     ToolTip="Where it is at the scene's scale. Editing it sets the millimetres beside it."
                                     Text="{Binding RealX, StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Y" Style="{StaticResource GizmoLabelY}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     AutomationProperties.AutomationId="RealPosY"
                                     Text="{Binding RealY, StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Z" Style="{StaticResource GizmoLabelZ}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     AutomationProperties.AutomationId="RealPosZ"
                                     Text="{Binding RealZ, StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{Binding RealUnit}" Style="{StaticResource GizmoUnit}" />
                        </StackPanel>

                        <!-- Snapping in millimetres is about where a thing lands, so it belongs to
                             moving alone. Turning has its own snap in degrees, and resizing has no
                             grid to land on. -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="Snap" Style="{StaticResource GizmoLabel}" />
                            <RadioButton Content="off" GroupName="Snap" VerticalAlignment="Center" Margin="0,0,7,0"
                                         IsChecked="{Binding SnapOff, Mode=TwoWay}" />
                            <RadioButton Content="1" GroupName="Snap" VerticalAlignment="Center" Margin="0,0,7,0"
                                         IsChecked="{Binding SnapOne, Mode=TwoWay}" ToolTip="Snap moves to whole millimetres" />
                            <RadioButton Content="5" GroupName="Snap" VerticalAlignment="Center" Margin="0,0,3,0"
                                         IsChecked="{Binding SnapFive, Mode=TwoWay}" ToolTip="Snap moves to 5 mm" />

                            <!-- Millimetres whatever the boxes are showing, because the choices are
                                 literally 1 and 5 mm - a grid to land a part on, not a reading of it.
                                 Relabelling this with the display unit made it say "5 ft". -->
                            <TextBlock Text="mm" Style="{StaticResource GizmoUnit}" />
                        </StackPanel>

                        <ToggleButton Style="{StaticResource ModeButton}" Margin="4,0,0,0"
                                      ToolTip="Stop where the object meets another rather than passing through it (C)"
                                      AutomationProperties.Name="Stop on contact"
                                      IsChecked="{Binding StopOnContact, Mode=TwoWay}">
                            <!-- Two blocks meeting, with the contact marked. -->
                            <Path Data="M2,5 L9,5 L9,15 L2,15 M18,5 L11,5 L11,15 L18,15 M10,3 L10,17"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource ModeButton}" Margin="2,0,0,0"
                                      ToolTip="Keep on bed: nothing is moved below the bed. Off: parts go wherever they are put, into the bed too."
                                      AutomationProperties.Name="Keep on bed when moving"
                                      IsChecked="{Binding KeepOnBedMove, Mode=TwoWay}">
                            <!-- A block standing on the hatched bed. -->
                            <Path Data="{StaticResource IconKeepOnBed}"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsRotateMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}"
                                    Visibility="{Binding DataContext.HasOneSelected,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Roll" Style="{StaticResource GizmoLabelX}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding RotationX, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Pitch" Style="{StaticResource GizmoLabelY}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding RotationY, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Yaw" Style="{StaticResource GizmoLabelZ}" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding RotationZ, StringFormat=N1, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <!-- Several selected: what they have in common, and typing sets all of
                             them to it. A group has no turn of its own to show. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasManySelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Roll" Style="{StaticResource GizmoLabelX}" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupRoll, Converter={StaticResource Mixed}, ConverterParameter=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Pitch" Style="{StaticResource GizmoLabelY}" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupPitch, Converter={StaticResource Mixed}, ConverterParameter=N1, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Yaw" Style="{StaticResource GizmoLabelZ}" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupYaw, Converter={StaticResource Mixed}, ConverterParameter=N1, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <TextBlock Text="deg" Style="{StaticResource GizmoUnit}" />
                        <ToggleButton Style="{StaticResource ModeButton}" Margin="4,0,0,0"
                                      ToolTip="Snap rotation to 15 degree steps"
                                      AutomationProperties.Name="Snap rotation"
                                      IsChecked="{Binding SnapRotation, Mode=TwoWay}">
                            <Path Data="M2,14 L7,14 L7,9 L13,9 L13,4 L18,4"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>

                        <Button Style="{StaticResource ModeAction}" Margin="2,0,0,0"
                                Command="{Binding AlignToAxesCommand}"
                                ToolTip="Set the angles back to zero without moving the object, so the resize arrows line up with the world again">
                            <!-- A corner of the world axes, with a turn sweeping back onto it. -->
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M3,3 L3,17 L17,17"
                                          Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M7,13 A7,7 0 0 1 15,6"
                                          Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                          StrokeStartLineCap="Round" />
                                    <Path Data="M11.6,5.2 L16.2,5.4 L14.2,9.6 Z" Fill="#FF33383F" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsScaleMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}"
                                    Visibility="{Binding DataContext.HasOneSelected,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="W" Style="{StaticResource GizmoLabelX}" ToolTip="Width - along X" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding DataContext.ObjectSizeX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="D" Style="{StaticResource GizmoLabelY}" ToolTip="Depth - along Y" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding DataContext.ObjectSizeY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="H" Style="{StaticResource GizmoLabelZ}" ToolTip="Height - along Z" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     Text="{Binding DataContext.ObjectSizeZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <!-- Several selected: how far the whole lot reaches. Typing carries the
                             parts with it, so the box comes out the size asked for. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasManySelected, Converter={StaticResource BoolToVisibility}}">
                            <!-- Several selected: the bounding box of the lot, so "width" here
                                 is how wide the group sits rather than any one part's own. -->
                            <TextBlock Text="W" Style="{StaticResource GizmoLabelX}" ToolTip="Width of the selection - along X" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupSizeX, Converter={StaticResource Mixed}, ConverterParameter=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="D" Style="{StaticResource GizmoLabelY}" ToolTip="Depth of the selection - along Y" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupSizeY, Converter={StaticResource Mixed}, ConverterParameter=0.####, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="H" Style="{StaticResource GizmoLabelZ}" ToolTip="Height of the selection - along Z" />
                            <TextBox Style="{StaticResource GizmoMixedBox}" Tag="transform"
                                     ToolTip="Type a value to set it, or +=5 / -=5 to change by that much. With the As one button off, every selected object gets it."
                                     Text="{Binding GroupSizeZ, Converter={StaticResource Mixed}, ConverterParameter=0.####, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource GizmoUnit}" />

                        <!-- The same numbers at the scene's scale, and editable: type metres
                             here or millimetres there and each follows the other. Only the
                             millimetres are stored - an STL has no notion of scale. Hidden at
                             1:1, where the two would say the same thing twice. -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                    Visibility="{Binding ScaleApplies, Converter={StaticResource BoolToVisibility}}">
                            <Rectangle Width="1" Margin="2,3,8,3" Fill="#FFD8DBE0" />
                            <TextBlock Text="W" Style="{StaticResource GizmoLabelX}" ToolTip="Width - along X" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     AutomationProperties.AutomationId="RealSizeW"
                                     ToolTip="How big it is at the scene's scale. Editing it sets the millimetres beside it."
                                     Text="{Binding RealW, StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="D" Style="{StaticResource GizmoLabelY}" ToolTip="Depth - along Y" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     AutomationProperties.AutomationId="RealSizeD"
                                     Text="{Binding RealD, StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="H" Style="{StaticResource GizmoLabelZ}" ToolTip="Height - along Z" />
                            <TextBox Style="{StaticResource GizmoBox}" Tag="transform"
                                     AutomationProperties.AutomationId="RealSizeH"
                                     Text="{Binding RealH, StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{Binding RealUnit}" Style="{StaticResource GizmoUnit}" />
                        </StackPanel>


                        <ToggleButton Style="{StaticResource ModeButton}" Margin="4,0,0,0"
                                      ToolTip="Keep proportions while resizing. Hold Ctrl while dragging a handle to do the opposite."
                                      AutomationProperties.Name="Keep proportions"
                                      IsChecked="{Binding UniformScale, Mode=TwoWay}">
                            <Path Data="M6,9 L6,5 A4,4 0 0 1 14,5 L14,9 M4,9 L16,9 L16,18 L4,18 Z"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ModeButton}" Margin="2,0,0,0"
                                      ToolTip="Grow one way only, holding the opposite face still (O). Hold Alt while dragging a handle to do the opposite."
                                      AutomationProperties.Name="One side only"
                                      IsChecked="{Binding ScaleOneSide, Mode=TwoWay}">
                            <!-- A wall on the left, an arrow growing away from it. -->
                            <Path Data="M3,3 L3,17 M6,10 L16,10 M12.5,6.5 L16,10 L12.5,13.5"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ModeButton}" Margin="2,0,0,0"
                                      ToolTip="Keep on bed: a part standing on the bed stays on it and grows upward only, and nothing is resized below the bed. Off: it grows about its middle, into the bed as well."
                                      AutomationProperties.Name="Keep on bed when resizing"
                                      IsChecked="{Binding KeepOnBedScale, Mode=TwoWay}">
                            <Path Data="{StaticResource IconKeepOnBed}"
                                  Stroke="#FF33383F" StrokeThickness="1.8" Fill="{x:Null}"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </ToggleButton>
                    </StackPanel>

                    <!-- Several selected: as one about the middle of the lot, or each on its own.
                         Last in the bar, with the other switches, rather than beside the mode
                         buttons: it is a setting of whichever mode is up, not a mode of its own. -->
                    <ToggleButton Style="{StaticResource ModeButton}" Margin="2,0,0,0"
                                  AutomationProperties.Name="As one"
                                  ToolTip="On: move, turn and resize the selection as one object, around its centre. Off: each object on its own, around its own centre."
                                  IsChecked="{Binding AroundSelectionCentre, Mode=TwoWay}"
                                  Visibility="{Binding HasManySelected, Converter={StaticResource BoolToVisibility}}">
                        <!-- A frame round three parts: the lot taken together. -->
                        <Path Data="M1,1 L19,1 L19,19 L1,19 Z M4,4 L9,4 L9,9 L4,9 Z M11,4 L16,4 L16,9 L11,9 Z M7.5,11 L12.5,11 L12.5,16 L7.5,16 Z"
                              Stroke="#FF33383F" StrokeThickness="1.5" Fill="{x:Null}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <TextBlock Margin="16" VerticalAlignment="Top" HorizontalAlignment="Left"
                       Foreground="#FF4A4F55" FontSize="13"
                       Text="Insert a shape to begin. Left-drag orbits, right-drag pans, wheel zooms. F1 lists every key.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Scene.Objects.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>

    <!-- Classic or Advanced: which tools the ribbon shows. At the right of the tab headers, where
         PrusaSlicer keeps its own switch, and outside the ribbon so a tool in hand does not grey it
         out. Not focusable, so a letter typed afterwards reaches the window's keys rather than
         picking a mode by its first letter. -->
    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,10,0" MinWidth="150"
              Focusable="False"
              ItemsSource="{Binding UiModes}" SelectedItem="{Binding UiMode, Mode=TwoWay}"
              AutomationProperties.AutomationId="UiMode"
              ToolTip="Classic shows the tools 3D Builder had. Advanced shows every tool - sketches, holes, threads, gears, blueprints and more. Keys work the same in both.">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Hint}">
                    <Ellipse Width="10" Height="10" Fill="{Binding Colour}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- Over everything while a long operation runs.
         A filled Border takes every mouse event that would have reached the ribbon or the
         viewport, which is the whole of the blocking: the keyboard is stopped in the code
         behind, because a shortcut fires wherever the pointer happens to be. -->
    <Border Name="BusyOverlay" Background="#66202428" Panel.ZIndex="10"
            KeyboardNavigation.TabNavigation="Cycle"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
        <Border Background="White" BorderBrush="#FFD4D8DE" BorderThickness="1" CornerRadius="4"
                Padding="24,20" MinWidth="320" MaxWidth="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding BusyTitle}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FF2C3037" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="BusyTitle" />
                <TextBlock Text="{Binding BusyStage}" Foreground="#FF3A4550" Margin="0,6,0,0"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="BusyStage" />

                <!-- Fills where the work can count itself and sweeps where it cannot. A boolean
                     has no honest fraction to show, so it says what it is doing instead. -->
                <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                             Value="{Binding BusyFraction, Mode=OneWay}"
                             IsIndeterminate="{Binding BusyIndeterminate}"
                             AutomationProperties.AutomationId="BusyBar"
                             Background="#FFEDEFF2" BorderThickness="0" Foreground="#FF3E7BD6" />

                <TextBlock Text="{Binding BusyElapsed}" Foreground="#FF8A9098" Margin="0,6,0,0"
                           AutomationProperties.AutomationId="BusyElapsed" />

                <TextBlock Text="{Binding BusyHint}" Margin="0,16,0,0" TextWrapping="Wrap"
                           Foreground="#FF5A5F66" />

                <Button Name="AbortButton" Content="Abort" HorizontalAlignment="Right"
                        Margin="0,18,0,0" MinWidth="92" Padding="12,6" Cursor="Hand"
                        AutomationProperties.AutomationId="Abort"
                        IsEnabled="{Binding CanAbort}" Command="{Binding AbortCommand}"
                        ToolTip="Stop and leave the model as it is (Esc)" />
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
